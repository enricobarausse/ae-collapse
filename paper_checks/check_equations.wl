order67 = -Exponent[Normal[rem67], Th, Max];
q67 = Coefficient[Expand[rhoAEexp], Qf[t, r]^2];
ok67 = (dat["coulombClaim"] === order67) && Normal[rem67] =!= 0 && Simplify[q67 - dat["q2Claim"] c13] === 0;
report["S67 Coulomb cancellation, -3/4 c13 Q^2", datL["coulombClaim"] <> "," <> datL["q2Claim"], "paper: cancellation up to O(1/Theta^" <> ToString[dat["coulombClaim"]] <> "); derived remainder (c14/2)(Theta'-1) d(Theta^2 a) = O(1/Theta^" <> ToString[order67] <> "); Q^2 coefficient " <> ToString[q67, InputForm],
   ok67, {Normal[rem67], q67}];


