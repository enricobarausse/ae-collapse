];
report["S63 eq:mc", "1067-1074", "vacuum a=K=Q=0 data: theta_C = 0 <=> m = const, so m_c = M_ADM, E = 0 initially", res63 === 0, res63];


(* ::Section:: *)
(*64. eq:Mae (L1075-1082)*)


(* LaTeX (L1078): M_{\text{\ae}}=\MADM-\frac{c_{14}}{8\pi G}\oint_\infty r^a a_a\,dA;  (L1081) "which gives \ $\MADM-\tfrac{c_{14}}{2}
   \lim_{\Theta\to\infty}\Theta^2a_r$ in spherical symmetry".
   Check: oint r^a a_a dA = 4 pi Theta^2 a_r (G=1) gives c14/2 -- the coefficient of eq:mc.  The coefficient c14/(8 pi G)
   itself and the positivity theorem are literature. *)
res64 = Simplify[c14/(8 Pi) 4 Pi Th^2 aa - c14/2 Th^2 aa];
