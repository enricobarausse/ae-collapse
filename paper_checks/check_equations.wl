(*15. eq:hamiltonian (L365-375): the printed Theta C is the code's theta_C*)


(* LaTeX (L365-366) "The Hamiltonian constraint is not imposed; multiplied by $\Theta$, it reads"; (L369-371):
     \Theta C\equiv{}&\Theta\Theta''+\tfrac12(\Theta'^2-1)+c_{14}\,a_r\Theta\Theta'\\
     &+\tfrac{\Theta^2}{4}\Bigl[c_{14}(2a_r'+a_r^2)+P^2+\psi'^2\\ &+\tfrac32(1-c_{13})Q^2-\tfrac13(2+c_{13}+3c_2)\trK^2\Bigr]=0 ,  (L375) "and we monitor it during the evolution".
   Check: the printed expression, typed in independently, equals the transcribed collapse.cpp theta_C (collapse.cpp:L1305-1315)
   identically.  That theta_C is (Theta^2/2)(rho_ae + rho_psi - G_uu), i.e. the Hamiltonian constraint G_uu = T_uu with
   G_ab = T_ab, is derived from the action in S59. *)
Block[{th = Thf[t, r], ps = psi[t, r], pm = Pf[t, r], kk = trk[t, r], q = Qf[t, r], a = arf[t, r], printed},
  printed = th D[th, {r, 2}] + (1/2) (D[th, r]^2 - 1) + c14 a th D[th, r] +
     (th^2/4) (c14 (2 D[a, r] + a^2) + pm^2 + D[ps, r]^2 + (3/2) (1 - c13) q^2 - (1/3) (2 + c13 + 3 c2) kk^2);
  res15 = Simplify[printed - thetaCcode[th, ps, pm, kk, q, a]];
];
