(*23. eq:expansions (L492-499), eq:ms (L501-505), M_hor = Theta_AH/2 (L506-512)*)


(* LaTeX (L492-498): "We use the expansions of the outgoing and ingoing radial null congruences orthogonal to the symmetry
   spheres, with null normals $u^a\pm e^a$ ($e^a$ the unit radial vector), rescaled by $\Theta/2$ and with the sign of the
   ingoing one reversed, so that both are positive on an ordinary sphere:
     \theta_\pm\equiv\partial_r\Theta\pm\tfrac16(3Q-2\trK)\Theta ."
   (L503) m=\frac{\Theta}{2}\,\bigl(1-\theta_+\theta_-\bigr);  (L509-512) "On the apparent horizon $\theta_+=0$, so
   Eq.~\eqref{eq:ms} gives $m=\ThAH/2$ ... the horizon mass and the horizon area $4\pi\ThAH^2$ grow or shrink together".
   Check (derivation): the expansion of a null congruence k orthogonal to the spheres is q^{ab} nabla_a k_b = 2 k(Theta)/Theta;
   rescaled by Theta/2 it is k(Theta).  So theta_+ = (u+e).grad Theta and theta_- = -(u-e).grad Theta must equal the
   printed formula (with the covariant Q, trK); theta_+ theta_- = g^{ab} d_a Theta d_b Theta (so eq:ms is the
   Misner-Sharp mass Theta(1 - (grad Theta)^2)/2); at theta_+ = 0, m = Theta/2; flat space: theta_pm = 1 > 0.
   The projected divergence is computed from the covariant nabla u and nabla e. *)
Block[{qProj, divProj, eLoV, Del},
  qProj = Table[ginv[[a, b]] + uUp[[a]] uUp[[b]] - eUp[[a]] eUp[[b]], {a, 4}, {b, 4}];   (* q^{ab} on the spheres *)
  Del = Table[D[eLo[[b]], X[[a]]] - Sum[Gam[[c, a, b]] eLo[[c]], {c, 4}], {a, 4}, {b, 4}];  (* nabla_a e_b *)
  divProj[s_] := Simplify[Sum[qProj[[a, b]] (Dl[[a, b]] + s Del[[a, b]]), {a, 4}, {b, 4}]];   (* expansion of u + s e *)
  thP = BB + (1/6) (3 QM - 2 trKM) Thf[t, r]; thM = BB - (1/6) (3 QM - 2 trKM) Thf[t, r];
  res23 = {(Thf[t, r]/2) divProj[1] - thP, -(Thf[t, r]/2) divProj[-1] - thM, thP - (uUp + eUp) . dTh, thM + (uUp - eUp) . dTh,
     hMS - thP thM, (mMS /. Solve[thP == 0, D[Thf[t, r], r]][[1]]) - Thf[t, r]/2,
     (thP /. {betaf -> (0 &), Nf -> (1 &), Thf -> Function[{t, r}, r]}) - 1, (thM /. {betaf -> (0 &), Nf -> (1 &), Thf -> Function[{t, r}, r]}) - 1};
];
report["S23 eq:expansions, eq:ms, M_hor", "492-512", "theta_pm = (Theta/2) x expansion of u pm e (ingoing sign reversed) = printed; theta+ theta- = (grad Theta)^2; m(theta+=0) = Theta/2; flat theta_pm = 1", isZeroAll[res23], Simplify[res23]];


