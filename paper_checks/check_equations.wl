(* ::Section:: *)
(*59. Aether stress tensor -> Hamiltonian and momentum constraints (behind eq:hamiltonian and eq:dm-coulomb)*)


(* The paper does not print the aether stress tensor, but eq:hamiltonian (S15), eq:dm-coulomb (S61) and the quadratic
   density (S67) need the aether SET.  Check (derivation from the action): build T^ae_ab from arXiv:1501.07274 eq. (2.34)
   (mostly-plus, with the J_(a^mu / J^mu_(a index order of the arXiv source), project on uu and ue.
   (i) rho_ae reduces, using ONLY kinematic definitions (no evolution equation), to
        rho_ae = c14 (a_r' + 2 a_r Theta'/Theta + a_r^2/2) - (3/4) c13 Q^2 - (c13/6 + c2/2) trK^2.
   (ii) G_uu (geometry) = -(2/Theta^2)(Theta Theta''+(Theta'^2-1)/2) + trK^2/3 - (3/4) Q^2.
   (iii) Hence G_uu = rho_ae + rho_psi is EXACTLY the code's theta_C/Theta = 0 (with kappa = 1), i.e. eq:hamiltonian.
   (iv) j_ae (needs d_t a_r, i.e. the code's a_r equation) = (c123 trK' - c13 P psi')/(1-c13);
        G_ue = (2/3) trK' - Q' - 3 Q Theta'/Theta, so G_ue = T_ue is the code's momentum constraint (compute_Q). *)
JUU = Simplify[Jmix . ginv];       (* J^{ab} *)
JLL = Simplify[gmet . Jmix];       (* J_{ab} *)
JLU = Simplify[JLL . ginv];        (* J_a^b  *)
Xtab = Table[(JLU[[a, mu]] uLo[[b]] + JLU[[b, mu]] uLo[[a]])/2 - (Jmix[[mu, a]] uLo[[b]] + Jmix[[mu, b]] uLo[[a]])/2 -
     (JLL[[a, b]] + JLL[[b, a]])/2 uUp[[mu]], {a, 4}, {b, 4}, {mu, 4}];
divX[a_, b_] := Sum[D[Xtab[[a, b, mu]], X[[mu]]], {mu, 4}] +
   Sum[Gam[[mu, mu, l]] Xtab[[a, b, l]] - Gam[[l, mu, a]] Xtab[[l, b, mu]] - Gam[[l, mu, b]] Xtab[[a, l, mu]], {mu, 4}, {l, 4}];
divJ[nu_] := Sum[D[JUU[[mu, nu]], X[[mu]]], {mu, 4}] + Sum[Gam[[mu, mu, l]] JUU[[l, nu]] + Gam[[nu, mu, l]] JUU[[mu, l]], {mu, 4}, {l, 4}];
uJd = Sum[uLo[[nu]] divJ[nu], {nu, 4}];
acc2 = accLo . accUp;
Tae[a_, b_] := -divX[a, b] - c1 (Sum[Dl[[m, a]] ginv[[m, n]] Dl[[n, b]], {m, 4}, {n, 4}] - Sum[Dl[[a, m]] Du[[b, m]], {m, 4}]) +
   (uJd + c4 acc2) uLo[[a]] uLo[[b]] + c4 accLo[[a]] accLo[[b]] - Lag gmet[[a, b]]/2;
rhoAE = Sum[Tae[a, b] uUp[[a]] uUp[[b]], {a, 2}, {b, 2}];
jAE = -Sum[Tae[a, b] uUp[[a]] eUp[[b]], {a, 2}, {b, 2}];
rhoAEred = kinReduce[rhoAE];
jAEred = evoReduce[jAE];
GuuRed = kinReduce[rhoG]; GueRed = kinReduce[-jG];
rhoAEexp = c14 (D[arf[t, r], r] + 2 arf[t, r] D[Thf[t, r], r]/Thf[t, r] + arf[t, r]^2/2) - (3/4) c13 Qf[t, r]^2 - (c13/6 + c2/2) trk[t, r]^2;
jAEexp = (c123 D[trk[t, r], r] - c13 Pf[t, r] D[psi[t, r], r])/(1 - c13);
GuuExp = -(2/Thf[t, r]^2) (Thf[t, r] D[Thf[t, r], {r, 2}] + (D[Thf[t, r], r]^2 - 1)/2) + trk[t, r]^2/3 - (3/4) Qf[t, r]^2;
GueExp = (2/3) D[trk[t, r], r] - D[Qf[t, r], r] - 3 Qf[t, r] D[Thf[t, r], r]/Thf[t, r];
rhoPsExp = (Pf[t, r]^2 + D[psi[t, r], r]^2)/2; jPsExp = -Pf[t, r] D[psi[t, r], r];
thC = thetaCcode[Thf[t, r], psi[t, r], Pf[t, r], trk[t, r], Qf[t, r], arf[t, r]];
Mc = momConCode[Thf[t, r], psi[t, r], Pf[t, r], trk[t, r], Qf[t, r]];
res59 = {rhoAEred - rhoAEexp, jAEred - jAEexp, GuuRed - GuuExp, GueRed - GueExp,
   thC + (Thf[t, r]^2/2) (GuuExp - rhoAEexp - rhoPsExp), (1 - c13) (GueExp + jAEexp + jPsExp) - Mc};
ok59 = isZeroAll[res59] && timeDerivs[rhoAEred] === {} && timeDerivs[kinReduce[jAE]] === {arf};
report["S59 T^ae -> constraints", "365-375,1044-1061", "rho_ae, j_ae from 1501.07274 (2.34); Ham. constraint = code theta_C = eq:hamiltonian (kinematics only); momentum constraint = compute_Q (needs the a_r equation)", ok59, {Simplify[res59], timeDerivs[rhoAEred], timeDerivs[kinReduce[jAE]]}];


(* ::Section:: *)
(*60. Inline (L1044-1049): a_r prop Theta^-2 around a black hole; Theta^2 a_r relaxes to a constant*)


(* LaTeX (L1044-1049): "The spin-0 front sets up the acceleration $a_r\propto\Theta^{-2}$ of the \ae ther around a black hole,
   absent from the initial data: behind the pulse $\Theta^2a_r$ relaxes to the same value on every sphere ..., the $F(u)/r^2$
   term of Eq.~\eqref{eq:asymptotic}."
   Check: for a static aether in the Schwarzschild exterior in the gamma_rr=1 gauge, a_r = d_r ln N with
   d_r = sqrt(1-2M/Theta) d_Theta gives Theta^2 a_r -> M exactly (a_r ~ Theta^-2); and after the pulse (F -> F_inf) the
   asymptotic a_r -> -bN F_inf/r^2 has the same form. *)
Block[{lapS, aS},
  lapS = Sqrt[1 - 2 MM/Th];
  aS = Sqrt[1 - 2 MM/Th] D[Log[lapS], Th];
  res60 = Limit[Th^2 aS, Th -> Infinity];
];
report["S60 Coulomb field a ~ M/Theta^2", "1044-1049", "static aether: Theta^2 a_r -> M (a_r ~ Theta^-2), the F_inf/r^2 term", res60 === MM, res60];


(* ::Section:: *)
(*60b. The confusing luminosity (L1037-1042) and the name "aether Coulomb field" (L1049) against the record*)


(* LaTeX (L1037-1042, DATA "lumConfusing"): "However, the luminosity gives a confusing answer for the radiated energy. As the pulse
   crosses a sphere, $m$ swings by an amount that grows with radius, and behind the pulse it settles above $\MADM$
   (Fig.~\ref{fig:coulomb}(b), thin lines), so that $\int L\,du$ is negative on every sphere."; (L1049, DATA "coulombName") "We call
   such a contribution the \ae ther Coulomb field." (a name: the F/r^2 term of S60, whose linear part in m is eq:dm-coulomb, S61).
   Check (derivation): L = -dm/du at fixed Theta, so int L du = -(m_end - m_start), negative whenever m ends above its start; from
   t = 0, where m = M_ADM outside the shell, it is -(m_end - M_ADM).
   Check (record, not printed; data/aether_coulomb.npz of the figure runs, sl600_N51201, thin lines = m - M_ADM on Theta = 75, 100, 150,
   200): swing (max - min over u = -60 ... 260) 7.05, 9.38, 14.05, 18.76 (increasing); m - M_ADM averaged over u = 200-250 1.171,
   1.140, 1.094, 1.052, minimum for u >= 120 1.045, 0.962, 0.813, 0.673 (> 0 on every sphere from u = 107 on); m - M_ADM at the start
   of the record (u = -60) 0.021, 0.076, 0.167, 0.235 and at the end 1.260, 1.263, 1.286, 1.320. *)
Block[{sw = {7.05, 9.38, 14.05, 18.76}, late = {1.171, 1.140, 1.094, 1.052}, mn = {1.045, 0.962, 0.813, 0.673},
    m0 = {0.021, 0.076, 0.167, 0.235}, m1 = {1.260, 1.263, 1.286, 1.320}, mm, uu, ua, ub, k0, k1, k2, k3, intL},
  intL = -(m1 - m0);
  mm = k0 + k1 uu + k2 uu^2 + Sin[k3 uu];   (* a generic m(u) at fixed Theta *)
  res60b = {Simplify[Integrate[-D[mm, uu], {uu, ua, ub}] + (mm /. uu -> ub) - (mm /. uu -> ua)], intL, -m1};
  ok60b = res60b[[1]] === 0 && And @@ Thread[Differences[sw] > 0] && Min[late] > 0 && Min[mn] > 0 && Max[intL] < 0 && Max[-m1] < 0;
];
report["S60b luminosity swing, m above M_ADM", "1037-1042,1049", "record: swing of m = 7.05, 9.38, 14.05, 18.76 (grows with radius); late m - M_ADM = 1.05-1.17 > 0 (> 0 from u = 107); int L du = -Delta m = " <>
  ToString[NumberForm[res60b[[2]], 3]] <> " < 0 on every sphere", ok60b, res60b];


(* ::Section:: *)
(*61. eq:dm-coulomb (L1051-1061)*)


(* LaTeX (L1055-1057): \partial_\Theta m={}&\frac{c_{14}}{2}\,\partial_r\Theta\;\partial_\Theta\!\left(\Theta^2a_r\right)\\
     &+\bigl(\text{terms quadratic in }a_r,\,\trK,\,Q,\,\psi\bigr), "with $\partial_r\Theta=1+O(M/\Theta)$. To leading order the
   linear term is a total derivative" (L1061-1062).
   Check (derivation): exact identity, with m = (Theta/2)(1 - Theta'^2 + A^2) and the code's theta_C,
     d_r m = -Theta' thetaC + (c14/2) Theta' d_r(Theta^2 a_r) + Theta' (Theta^2/4) q + Theta' A^2/2 + Theta A A',
     q = c14 a^2 + P^2 + psi'^2 + (3/2)(1-c13) Q^2 - (den/3) trK^2.
   Divide by Theta': on C = 0, d_Theta m = (c14/2) Theta' d_Theta(Theta^2 a_r) + quadratic: exactly eq:dm-coulomb with
   its Theta' factor; Theta' = 1 + O(M/Theta) (sqrt(1-2M/Theta) on the black-hole background). *)
Block[{Aex, mR, qd},
  Aex = Thf[t, r] (Qf[t, r]/2 - trk[t, r]/3);
  mR = Thf[t, r]/2 (1 - D[Thf[t, r], r]^2 + Aex^2);
  qd = c14 arf[t, r]^2 + Pf[t, r]^2 + D[psi[t, r], r]^2 + (3/2) (1 - c13) Qf[t, r]^2 - (den/3) trk[t, r]^2;
  res61 = Simplify[D[mR, r] - (-D[Thf[t, r], r] thC + (c14/2) D[Thf[t, r]^2 arf[t, r], r] D[Thf[t, r], r] +
        D[Thf[t, r], r] (Thf[t, r]^2/4) qd + D[Thf[t, r], r] Aex^2/2 + Thf[t, r] Aex D[Aex, r])];
  res61mm = kinReduce[mMS - mR];   (* the MS mass of the metric equals Theta/2 (1 - Theta'^2 + A^2) *)
];
report["S61 eq:dm-coulomb", "1051-1061", "exact: d_Theta m = (c14/2) Theta' d_Theta(Theta^2 a) + quadratic = eq:dm-coulomb (Theta' factor included)", res61 === 0 && res61mm === 0, {res61, res61mm}];


