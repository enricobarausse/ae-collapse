  "appScatFig"      -> <|"v" -> {0.01, 6401, 12801, 25601, 150, 20, 4}, "L" -> "1529-1535", "tex" -> "$A_0=0.01$, on the nested grids $N_r=6401/12801/25601$ ($r_{\\max}=150$).  Each panel shows, against $t$ and on a logarithmic scale, the $L_2$ norms over $0<r<20$ of $f_h-f_{h/2}$ and $4(f_{h/2}-f_{h/4})$. The curves overlap for second-order convergence."|>,
  "appScatA006"     -> <|"v" -> {0.06, 12}, "L" -> "1541-1543", "tex" -> "for $A_0=0.06$, the strongest shell of the scattering test. The curves of $\\trK$, $a_r$ and $Q$ separate after the bounce ($t\\gtrsim12$)."|>,
  "appConstraintCap" -> <|"v" -> {20, 6401, 12801, 25601, 0.01, 0.04, 0.06, 12}, "L" -> "1550-1556", "tex" -> "$\\|\\Theta C\\|_2$ over $0<r<20$ against $t$ for $N_r=6401/12801/25601$, rescaled by $N_r^2$ and normalised to the coarsest grid (factors $1$, $4$ and $16$). (a) Weak field, $A_0=0.01$; (b) strong field, $A_0=0.04$; (c) $A_0=0.06$, the strongest shell. In the weak and strong-field cases the three resolutions collapse onto one curve, i.e.\\ $\\|\\Theta C\\|\\to0$ at second order; for $A_0=0.06$ they separate after the bounce ($t\\gtrsim12$)."|>,
  "appAHMesh"       -> <|"v" -> 2, "L" -> "1565-1566", "tex" -> "The apparent horizon is present from $t=2$, with $\\ThAH\\simeq8.5$"|>,
  "appMeshN"        -> <|"v" -> {51201, 250}, "L" -> "1571-1572", "tex" -> "On the moving mesh at $N_r=51201$, the ADM mass read at $\\Theta=250$ is"|>,
  "tabConvRatioCap" -> <|"v" -> {2, 150, 12801, 25601, 51201, 300, 0.35, 4}, "L" -> "1576-1579", "tex" -> "Constraint-norm ratios outside the apparent horizon ($r_{\\rm AH}+2\\le r\\le150$) on the nested fixed grid $N_r=12801/25601/51201$ ($r_{\\max}=300$, $A_0=0.35$); a ratio of $4$ is exact second order."|>,
  "convCollapseCap" -> <|"v" -> {0.35, 300, 2, 150, 12801, 25601, 51201}, "L" -> "1594-1598", "tex" -> "Hamiltonian constraint in the collapse test ($A_0=0.35$, $r_{\\max}=300$, fixed grid): $\\|\\Theta C\\|_2$ outside the apparent horizon, over $r_{\\rm AH}+2\\le r\\le150$, against $t$ on the nested grids $N_r=12801/25601/51201$, rescaled by $N_r^2$. The rescaled curves coincide if $\\|\\Theta C\\|\\to0$ at second order."|>,
  "convRescale"     -> <|"v" -> {1, 4, 16}, "L" -> "1551-1552", "tex" -> "rescaled by $N_r^2$ and normalised to the coarsest grid (factors $1$, $4$ and $16$)"|>,
  "appAH"           -> <|"v" -> {8.5, 10^-6}, "L" -> "1566-1567", "tex" -> "with $\\ThAH\\simeq8.5$, and by $t=28$ the central lapse is below $10^{-6}$"|>,
  "appWindow"       -> <|"v" -> {9, 65, 137, 90}, "L" -> "1568-1570", "tex" -> "$r_{\\rm AH}$ grows from $\\simeq9$ at $t=2$ to $\\simeq65$ at $t=28$, while the areal radius at $r=150$ decreases from $\\simeq137$ to $\\simeq90$"|>,
  "ThAHt28"         -> <|"v" -> {12.293, 12.604, 12.677}, "L" -> "1571", "tex" -> "$\\ThAH=12.293$, $12.604$ and $12.677$"|>,
