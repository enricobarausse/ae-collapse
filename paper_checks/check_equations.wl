  "ratioRow2"       -> <|"v" -> {3.95, 3.97, 5.59, 6.26, 6.12, 5.95, 5.82}, "L" -> "1586", "tex" -> "& 3.95 & 3.97 & 5.59 & 6.26 & 6.12 & 5.95 & 5.82"|>,
  "finestBelow"     -> <|"v" -> 10, "L" -> "1598-1599", "tex" -> "From $t\\simeq10$ the curve of the finest grid lies below the other two"|>,
  (* --- Sec. IV, mass function --- *)
  "Mhor"            -> <|"v" -> {28, 6.35}, "L" -> "679-681", "tex" -> "the Misner--Sharp mass at $t=28$, when the apparent horizon is largest. Outside the horizon, $m$ decreases outward from $\\Mhor=\\ThAH/2=6.35$ (Richardson limit of $\\ThAH$"|>,
  "MADM"            -> <|"v" -> 3.7111, "L" -> "683", "tex" -> "to $\\MADM=3.7111$ at large radius"|>,
  "Mdiff"           -> <|"v" -> -2.64, "L" -> "687", "tex" -> "carries a net energy $\\MADM-\\Mhor=-2.64$"|>,
  "decClaim"        -> <|"v" -> Null, "L" -> "706-712", "tex" -> "non-negative on untrapped spheres: outside the apparent horizon, $m$ can decrease outward only where the dominant energy condition is violated~\\cite{Hayward:1994bu}. The outward decrease of $m$ in Fig.~\\ref{fig:mass} therefore requires a violation of the dominant energy condition outside the horizon"|>,
  "penroseClaim"    -> <|"v" -> Null, "L" -> "719-722", "tex" -> "In GR with matter obeying the dominant energy condition, integrating Eq.~\\eqref{eq:dmdTheta} from the horizon to infinity gives the spherical Penrose inequality"|>,
  "aeAtMost"        -> <|"v" -> -2.64, "L" -> "714-715", "tex" -> "violation comes from the \\ae ther, whose contribution to the exterior energy is at most $-2.64$"|>,
  "aeBand"          -> <|"v" -> {18, 20, 28}, "L" -> "717", "tex" -> "($18\\lesssim\\Theta\\lesssim20$ at $t=28$)"|>,
  "Mratio"          -> <|"v" -> 1.71, "L" -> "725", "tex" -> "\\frac{\\Mhor}{\\MADM}=1.71"|>,
  "ThAHshrink"      -> <|"v" -> {28, 12.6, 11.8, 150}, "L" -> "731-732", "tex" -> "peaks at $t\\simeq28$ and then decreases slowly, from $12.6$ to $11.8$ by $t=150$"|>,
  "massCaption"     -> <|"v" -> {3.7111, 5}, "L" -> "743", "tex" -> "$\\MADM=3.7111$ (green, dotted). The narrow spike at $\\Theta\\approx5$"|>,
  (* --- Sec. V, spin-0 --- *)
  "charExact"       -> <|"v" -> Null, "L" -> "799-802", "tex" -> "They become exact characteristic variables of the full system far from the source, where the terms coupling them to $\\Theta$ and $\\psi$, proportional to $a_r/\\Theta$ and $P$, fall off."|>,
  "reflScalar"      -> <|"v" -> {0.03}, "L" -> "882", "tex" -> "A scalar pulse is reflected with $0.03\\%$ of its amplitude."|>,
  "reflSpin0"       -> <|"v" -> {50, 16, 100, 150, 10^-5, 3.5, 2.3}, "L" -> "877-881", "tex" -> "A spin-0 pulse $\\trK\\propto\\exp[-(r-50)^2/16]$ crossing a flat-space boundary at $r_{\\max}=100$ and $150$, for $v_0=1$ and $1.267$, is reflected into $\\win$ below $10^{-5}$ of the incident $\\wout$, against $3.5\\%$ ($r_{\\max}=100$) and $2.3\\%$ ($r_{\\max}=150$) when $\\win$ is set to zero"|>,
  "resultsIntro"    -> <|"v" -> {1, 1.267}, "L" -> "887-889", "tex" -> "baseline couplings, for which $v_0=1$ and the spin-0 and scalar signals travel together, and one with $c_2=0$, for which $v_0=1.267$ and the two signals separate"|>,
  "resultsSteps"    -> <|"v" -> Null, "L" -> "890-894", "tex" -> "We first extract the spin-0 waveform from the outgoing characteristic variable $\\wout$ and check that it falls off as $1/\\Theta$. We then measure the speed of the signal in two independent ways: with a linear probe pulse on the collapse background, and with the burst in the Misner--Sharp luminosity, used as a clock between spheres."|>,
  "wbarEq"          -> <|"v" -> Null, "L" -> "897-906", "tex" -> "To isolate the pulse, we split $\\wout$ on each sphere into a slowly varying background $\\bar w_{\\rm out}$ and a fast remainder $\\delta\\wout$, smoothing $\\wout$ in time with a Gaussian kernel: \\begin{equation} \\bar w_{\\rm out}(\\Theta,t)= \\frac{\\int\\wout(\\Theta,t')\\,e^{-(t-t')^2/2\\sigma^2}\\,dt'} {\\int e^{-(t-t')^2/2\\sigma^2}\\,dt'}, \\label{eq:wbar} \\end{equation} and $\\delta\\wout=\\wout-\\bar w_{\\rm out}$."|>,
  "sigmaFilter"     -> <|"v" -> {10, 5, 15}, "L" -> "907-909", "tex" -> "With a width $\\sigma=10$, the remainder isolates the pulse $\\Theta\\,\\delta\\wout$, whose amplitude depends on $\\sigma$ but is the same on every sphere for any $\\sigma\\in[5,15]$"|>,
  "probe"           -> <|"v" -> {10^-6, 150}, "L" -> "936-937", "tex" -> "(amplitude $10^{-6}$, centred at $r=150$)"|>,
  "probeExact"      -> <|"v" -> Null, "L" -> "940-943", "tex" -> "the outgoing spin-0 characteristic moves at exactly $v_0$ relative to the \\ae ther, measured in its proper time and proper radial distance, so this measurement requires no approximation of the background"|>,
  "probeScatter"    -> <|"v" -> {40, 3 10^-4}, "L" -> "944-947", "tex" -> "The scatter at early times, $t\\lesssim40$, comes from the splitting of the initial $\\trK$ pulse, which has both $\\wout$ and $\\win$ components, into its outgoing and ingoing parts; afterwards, the deviation stays below $3\\times10^{-4}$."|>,
  "probeMedText"    -> <|"v" -> {0.01, 0.02}, "L" -> "947", "tex" -> "The median speed agrees with $v_0$ to $0.01\\%$ for $v_0=1$ and to $0.02\\%$ for $v_0=1.267$."|>,
  "lumDef"          -> <|"v" -> Null, "L" -> "952-954", "tex" -> "luminosity through a sphere of fixed areal radius, $L=-dm/dt|_\\Theta$ (its decomposition into \\ae ther and scalar fluxes is given in Sec.~\\ref{sec:flux})."|>,
  "lumBurst"        -> <|"v" -> {10, 15}, "L" -> "955-957", "tex" -> "For $v_0=1.267$, $L$ shows on every sphere a sharp burst at $u\\simeq10$--$15$, followed by a broad oscillation (Fig.~\\ref{fig:lum}(a)); the burst coincides with the narrow pulse of $\\wout$."|>,
  "lumSpheres"      -> <|"v" -> {120, 400}, "L" -> "958", "tex" -> "arrival time of the burst on each of the spheres $\\Theta=120$--$400$"|>,
  "lagLine"         -> <|"v" -> Null, "L" -> "961-963", "tex" -> "A signal moving at speed $v$ in tortoise distance gives a straight line of slope $1/v$. The arrival times lie on a line"|>,
  "lagSpeed"        -> <|"v" -> {1.241, 2}, "L" -> "963", "tex" -> "a linear fit gives $v=1.241$, $2\\%$ below $v_0=1.267$"|>,
  "burstSpin0"      -> <|"v" -> Null, "L" -> "966-967", "tex" -> "The burst is therefore carried by the spin-0 mode, not by the scalar field, which propagates at the speed of light."|>,
  "lagCaption"      -> <|"v" -> {1.241, 2, 1.267}, "L" -> "989", "tex" -> "speed $1.241$, $2\\%$ below $v_0=1.267$"|>,
  "probeDev"        -> <|"v" -> {0.01, 0.02}, "L" -> "976-977", "tex" -> "agree with $v_0$ to $0.01\\%$ and $0.02\\%$, respectively"|>,
  "lumCapCoulomb"   -> <|"v" -> Null, "L" -> "985-986", "tex" -> "It is dominated by the \\ae ther Coulomb term (Sec.~\\ref{sec:flux})."|>,
  "fluxOpening"     -> <|"v" -> Null, "L" -> "997-1002", "tex" -> "We first check that, at every time, the change of the Misner--Sharp mass on each sphere is accounted for by the flux of the stress-energy tensor through it. We then show that most of this flux is the \\ae ther Coulomb field, which is linear in the wave amplitude, and remove it to obtain the radiated energy."|>,
  "fluxHayward"     -> <|"v" -> Null, "L" -> "1004", "tex" -> "The time derivative of the Misner--Sharp mass at fixed areal radius equals the flux of the stress-energy tensor through the sphere~\\cite{Hayward:1994bu}."|>,
  "lumRoute"        -> <|"v" -> Null, "L" -> "1004", "tex" -> "Using the field equations $G_{ab}=T_{ab}$, one obtains the luminosity $L$"|>,
  "lumConfusing"    -> <|"v" -> Null, "L" -> "1037-1042", "tex" -> "However, the luminosity gives a confusing answer for the radiated energy. As the pulse crosses a sphere, $m$ swings by an amount that grows with radius, and behind the pulse it settles above $\\MADM$ (Fig.~\\ref{fig:coulomb}(b), thin lines), so that $\\int L\\,du$ is negative on every sphere."|>,
  "coulombName"     -> <|"v" -> Null, "L" -> "1049", "tex" -> "We call such a contribution the \\ae ther Coulomb field."|>,
  "fluxResid"       -> <|"v" -> {0.02, 40, 200}, "L" -> "1017-1018", "tex" -> "agree to within $0.02\\%$ of the peak flux at all times on every sphere from $\\Theta=40$ to $200$"|>,
  "fluxScalar"      -> <|"v" -> {0.02, 0.9, 4}, "L" -> "1020-1021", "tex" -> "$|F_\\psi|\\lesssim0.02$, against \\ae ther-flux peaks of $0.9$--$4$"|>,
  "fluxSpheres"     -> <|"v" -> {40, 100, 200}, "L" -> "1027", "tex" -> "on the spheres $\\Theta=40$, $100$ and $200$"|>,
  "Th2arExp"        -> <|"v" -> 0.7, "L" -> "1090-1091", "tex" -> "grows with $\\Theta$ (roughly as $\\Theta^{0.7}$)"|>,
  "MADMsuper" -> <|"v" -> 3.708, "L" -> "1098", "tex" -> "For the superluminal case $c_2=0$ with $\\MADM=3.708$"|>,
  "Erun"            -> <|"v" -> {75, 200, 0.197}, "L" -> "1100", "tex" -> "$E_\\infty+b/\\Theta+O(1/\\Theta^2)$ over $\\Theta=75$--$200$, and the scalar flux gives $E_\\psi=0.197$"|>,
  "corrRate"        -> <|"v" -> 10, "L" -> "1114-1116", "tex" -> "the rate $L=-\\partial_u m_c|_\\Theta$ (panel (a)) is more than an order of magnitude smaller than the uncorrected luminosity of Fig.~\\ref{fig:lum}(a)"|>,
  "Esame"           -> <|"v" -> Null, "L" -> "1117-1119", "tex" -> "the cumulative energy $E$ (panel (b)) is nearly the same on all spheres once the pulse has passed; its extrapolation to infinity, shown once the pulse has crossed all spheres, settles on the value of Eq.~\\eqref{eq:Einf}."|>,
  "Einf"            -> <|"v" -> {0.532, 0.023, 0.144, 0.006}, "L" -> "1104", "tex" -> "E_\\infty=0.532\\pm0.023=(0.144\\pm0.006)\\,\\MADM"|>,
  "Eae"             -> <|"v" -> {0.335, 0.090}, "L" -> "1105", "tex" -> "E_{\\text{\\ae}}=E_\\infty-E_\\psi=0.335=0.090\\,\\MADM"|>,
  "pctAe"           -> <|"v" -> 9, "L" -> "1109", "tex" -> "so the spin-0 wave carries off $9\\%$ of the ADM mass"|>,
  "EinfCaption"     -> <|"v" -> {0.53, 0.02}, "L" -> "1135", "tex" -> "$E_\\infty=0.53\\pm0.02$"|>,
  (* --- Sec. VI, white holes --- *)
  "whCouplings"     -> <|"v" -> {0.8, -0.7111}, "L" -> "1255-1256", "tex" -> "We take $c_1=0.8$, $c_3=c_4=0$ and $c_2=-c_1^3/(2-4c_1+3c_1^2)=-0.7111$, which keeps $v_0=1$"|>,
  "whID"            -> <|"v" -> {10, 4}, "L" -> "1265", "tex" -> "with $r_0=10$ and $\\sigma=4$"|>,
  "whA012"          -> <|"v" -> 0.12, "L" -> "1273", "tex" -> "$A_0=0.12$ the data are initially untrapped everywhere"|>,
  "whTcross"        -> <|"v" -> 2.5, "L" -> "1274", "tex" -> "$\\theta_+$ crosses zero by $t\\simeq2.5$ and a black hole forms"|>,
  "whTimeline"      -> <|"v" -> {36, 40}, "L" -> "1277-1278", "tex" -> "grows, its outer edge moving out with the escaping pulse, until it splits at $t\\simeq36$. The inner part shrinks after $t\\simeq40$ and"|>,
  "whTimelineStart" -> <|"v" -> {0.10, 6, 17, 20}, "L" -> "1275-1276", "tex" -> "With $A_0=0.10$, after a brief dip of $\\theta_+$ below zero at $t\\simeq6$--$17$, an anti-trapped region appears at $t\\simeq20$ and"|>,
  "whGone"          -> <|"v" -> 44, "L" -> "1279", "tex" -> "disappears by $t\\simeq44$"|>,
  "whLayerNarrow"   -> <|"v" -> {0.9, 40, 0.06, 80, 20}, "L" -> "1279-1284", "tex" -> "while a thin anti-trapped layer stays around the peak of the escaping pulse and travels outward with it (Fig.~\\ref{fig:wh}(a)). The layer is present on all our grids and narrows with the pulse, from about $0.9$ at $t=40$ to $0.06$ at $t=80$ on the refined grids, which agree on its width to within $20\\%$; its depth, $\\min\\theta_-$, still grows with resolution."|>,
  "aggT"            -> <|"v" -> 17, "L" -> "1287", "tex" -> "first appears at a similar time ($t\\simeq17$)"|>,
  "whCompress"      -> <|"v" -> {0.15, 8}, "L" -> "1297-1304", "tex" -> "its width shrinking roughly as $e^{-0.15t}$. We resolve it by adding a moving refinement to the coordinate map of Sec.~\\ref{sec:method}. The number of grid points does not change: the computational coordinate is first reparametrised so that the points cluster in a region, a few units wide, where the spacing is eight times finer, and are drawn from a band around it, while the grid elsewhere is left exactly as it was. This is not adaptive mesh refinement: there are no nested grids, and the refinement factor is fixed."|>,
  "whTracking"      -> <|"v" -> Null, "L" -> "1304-1305", "tex" -> "The centre of the region follows the peak of $|P|$ through a feedback controller"|>,
  "whShell"         -> <|"v" -> {6.9, 29.5, 30, 7, 3, 4}, "L" -> "1316-1319", "tex" -> "$\\Theta\\simeq6.9$, and at $t\\simeq29.5$ it steepens beyond what any of our grids resolves (Fig.~\\ref{fig:sharp}(c)). Figure~\\ref{fig:wh}(b,c) measures the width and height of the peak of Fig.~\\ref{fig:sharp}(c) at $t=30$ on seven grids: three uniform, and four with a refined region of the same kind,"|>,
  "whShellRefine"   -> <|"v" -> {8, 16, 20, 30.5}, "L" -> "1319-1323", "tex" -> "four with a refined region of the same kind, eight or sixteen times finer. Since the shell forms abruptly, with no earlier peak to follow, this region is placed at the radius where the uniform runs show the shell forming and is held there from $t=20$ until $t=30.5$."|>,
  "whExponents"     -> <|"v" -> {0.8, -0.5, -1}, "L" -> "1325-1326", "tex" -> "peak shrinks roughly as $dr^{0.8}$, its height grows as $dr^{-0.5}$ and the energy density as $dr^{-1}$"|>,
  "whThree"         -> <|"v" -> 3, "L" -> "1291-1295", "tex" -> "On coarse grids the white-hole profiles exhibit three narrow features, each with a different physical origin. Figure~\\ref{fig:sharp}(a) shows them on one profile, at $t=40$, and Fig.~\\ref{fig:wh}(a) follows their areal radius in time: the escaping pulse (green), the inner shell (black) and the inner front (yellow)."|>,
  "whRay"           -> <|"v" -> {30, 3.2, 34, 0.3, 40, 0.1}, "L" -> "1309-1312", "tex" -> "The compression is visible in the outgoing light rays, which converge on the pulse: the ray that leaves the inner shell at $t=30$, $3.2$ behind the peak, is $0.3$ behind it at $t=34$ and $0.1$ at $t=40$ (Fig.~\\ref{fig:wh}(a))."|>,
  "whFront"         -> <|"v" -> {7, 0.3, 0.13, 3.2}, "L" -> "1332-1337", "tex" -> "A third, weaker feature forms inside the shell. From $t\\simeq7$ part of the ingoing scalar pulse travels as a front, a jump of about $0.3$ in $P$, along ingoing light rays, $\\dot r=-\\beta-N$. Where it travels the lapse drops to $N\\simeq0.13$, and the front nearly stalls at $\\Theta\\simeq3.2$, close to the inner edge of the anti-trapped region (Fig.~\\ref{fig:wh}(a))."|>,
  "whFrontSlope"    -> <|"v" -> {24, 40}, "L" -> "1336-1340", "tex" -> "Its steepest slope changes little with resolution at $t=24$ but doubles with each halving of $dr$ by $t=40$ (Fig.~\\ref{fig:sharp}(d)), so it too steepens beyond our resolution."|>,
  "whFrontFall"     -> <|"v" -> {44, 54}, "L" -> "1340-1341", "tex" -> "The lapse then recovers, the front falls to the centre at $t\\simeq44$ and has dispersed by $t\\simeq54$."|>,
  "whSingT"         -> <|"v" -> 29.5, "L" -> "1327", "tex" -> "consistent with a singularity forming at $t\\simeq29.5$"|>,
  "freezeExp"       -> <|"v" -> 1/3, "L" -> "1356", "tex" -> "roughly as $dr^{-1/3}$, with no sign of converging"|>,
  "otherData"       -> <|"v" -> {10, 3, 15, 4, 0.01, 0.015, 0.03}, "L" -> "1359-1360", "tex" -> "$(r_0,\\sigma)=(10,3)$ and $(15,4)$, with the same outcome. Weak data disperse ($A_0=0.01$, $0.015$ and $0.03$ for $\\sigma=3$)"|>,
  "s3A08"           -> <|"v" -> {0.08, 0.009, 0.0047}, "L" -> "1365-1366", "tex" -> "for $\\sigma=3$, $A_0=0.08$ gives a trapped region that later disappears at $dr\\simeq0.009$, but a persistent black hole at $dr\\simeq0.0047$"|>,
  "r15A"            -> <|"v" -> 0.028, "L" -> "1367", "tex" -> "for $r_0=15$, $A_0=0.028$"|>,
  "r15t"            -> <|"v" -> {20, 24, 3}, "L" -> "1369-1370", "tex" -> "is gone by $t\\simeq20$ and the anti-trapped region appears at $t\\simeq24$, identically on three grids"|>,
  "s3A03"           -> <|"v" -> {0.03, 0.0031, 0.0016, 0.0008, 0.04}, "L" -> "1372-1373", "tex" -> "at $A_0=0.03$ it occurs at $dr=0.0031$, not at $0.0016$, and again at $0.0008$, and at $A_0=0.04$ it"|>,
  "aggGrid"         -> <|"v" -> {32, 40000, 80000}, "L" -> "1385-1386", "tex" -> "near $t\\simeq32$ are not fully resolved with $40{,}000$ and $80{,}000$ points"|>,
  "aggShell"        -> <|"v" -> {2, 2.5, 7}, "L" -> "1391-1393", "tex" -> "with $\\sigma=2$, is about $2.5$ times wider than ours, those runs use a different radial coordinate, and their feature sits near the centre rather than at $\\Theta\\simeq7$"|>,
  "whFig"           -> <|"v" -> {0.8, 0.10, 0.0008}, "L" -> "1415-1416", "tex" -> "The transient white hole at $c_1=0.8$, $A_0=0.10$. (a) Areal radius against $t$, on the uniform grid with $dr=0.0008$"|>,
