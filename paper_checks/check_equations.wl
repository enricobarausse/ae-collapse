(*2. Introduction (L130): "the combination of the coupling parameters $c_1+c_3$" must vanish*)


(* LaTeX (L129-131): "fixed the speed of the spin-2 mode to that of light to within a part in $10^{15}$. This requires
   the combination of the coupling parameters $c_1+c_3$ to vanish".
   Check (derivation): v2 = (1 - c13)^(-1/2) = 1 + c13/2 + O(c13^2) (eq:speeds), so a part in 1e15 on v2 means
   c13 = c1 + c3 ~ 1e-15 (same as S09, L278); the snippet guards the corrected wording. *)
res02 = Simplify[Normal[Series[(1 - c13x)^(-1/2), {c13x, 0, 1}]] - (1 + c13x/2)];
report["S02 L130 c1+c3 must vanish", datL["gwCombination"], "a part in 1e15 on v2 <=> c1 + c3 = c13 ~ 1e-15 (v2 - 1 = c13/2 + O(c13^2))", res02 === 0, res02];


(* ::Section:: *)
(*3. eq:action and the tensor M (L236-248)*)


(* LaTeX (L238-240, L246-247):
     S=\frac{1}{16\pi G}\int d^4x\,\sqrt{-g}\,\Bigl(R - M^{ab}{}_{mn}\nabla_a u^m\nabla_b u^n\\ &+ \lambda\,(u^a u_a+1)\Bigr) + S_{\rm matter},
     M^{ab}{}_{mn}=c_1 g^{ab}g_{mn}+c_2\delta^a_m\delta^b_n+c_3\delta^a_n\delta^b_m-c_4u^au^bg_{mn}.
   Check (derivation): build M as an explicit 4-index array for the code's metric and the hypersurface-orthogonal
   unit aether u_a = -N d_a t, form J^a_m = M^{ab}_{mn} nabla_b u^n and the kinetic term M nabla u nabla u.
   We verify (i) J equals c1 nabla^a u_m + c2 delta^a_m (div u) + c3 nabla_m u^a - c4 u^a a_m (the form used for the
   SET in S59) and (ii) for a hypersurface-orthogonal aether the kinetic term is c13 K_ab K^ab + c2 K^2 - c14 a^2,
   i.e. c3 enters only through c13 (the twist term drops), consistent with L251-254. *)
Mt = Table[c1 ginv[[a, b]] gmet[[m, n]] + c2 KroneckerDelta[a, m] KroneckerDelta[b, n] + c3 KroneckerDelta[a, n] KroneckerDelta[b, m] -
    c4 uUp[[a]] uUp[[b]] gmet[[m, n]], {a, 4}, {b, 4}, {m, 4}, {n, 4}];
Jmix = Simplify[Table[Sum[Mt[[a, b, m, n]] Du[[b, n]], {b, 4}, {n, 4}], {a, 4}, {m, 4}]];   (* J^a_m *)
Jalt = Table[c1 Sum[ginv[[a, b]] Dl[[b, m]], {b, 4}] + c2 KroneckerDelta[a, m] divu + c3 Du[[m, a]] - c4 uUp[[a]] accLo[[m]], {a, 4}, {m, 4}];
Lag = Simplify[Sum[Jmix[[a, m]] Du[[a, m]], {a, 4}, {m, 4}]];
KK = Simplify[Sum[Kab[[a, b]] Kab[[c, d]] ginv[[a, c]] ginv[[b, d]], {a, 4}, {b, 4}, {c, 4}, {d, 4}]];
trKcov = Simplify[Sum[ginv[[a, b]] Kab[[a, b]], {a, 4}, {b, 4}]];
res3 = {Jmix - Jalt, Lag - (c13 KK + c2 trKcov^2 - c14 accLo . accUp), KK - (trKM^2/3 + 3 QM^2/2)};
report["S03 eq:action/M", "236-248", "J from M; M grad u grad u = c13 K.K + c2 K^2 - c14 a^2 (HO aether, twist-free)", isZeroAll[res3], Simplify[res3[[2]]]];


