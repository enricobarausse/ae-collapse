(* ::Section:: *)
(*6. eq:speeds (L259-266): v2, v1, v0 derived from the action*)


(* LaTeX (L261-263) as in S05.
   Check (derivation): expand sqrt(-g) (R - M^{ab}_{mn} nabla_a u^m nabla_b u^n) to second order about Minkowski
   with u = d_t, for plane waves along z (all fields functions of t and z; the unit norm fixes u^t to second order).
   spin-2: h_xy.  spin-1: (h_tx, h_xz, v^x), gauge h_xz = 0.  spin-0: (h_tt, h_tz, h_zz, h_xx = h_yy, v^z), gauge
   h_tz = h_zz = 0.  The Euler-Lagrange equations of ALL fields of a sector (constraints included) are evaluated on
   exp(i(k z - w t)); the dispersion relation is the gcd of the maximal minors of the Fourier matrix, and must vanish
   at w^2 = v^2 k^2 with the quoted v^2.  Same construction as the SymPy audit (independent code). *)
pwX = {tt, xx, yy, zz};
pwEta = DiagonalMatrix[{-1, 1, 1, 1}];
pwLagr2[hmat_, usp_] := Module[{g, gi, Gam, Ric, Rs, uu, ut, s1, s2, nrm, ns, S1, S2, Du, Mt, Lag, sq},
  g = pwEta + eps hmat;
  gi = Expand[pwEta - pwEta . hmat . pwEta eps + pwEta . hmat . pwEta . hmat . pwEta eps^2];   (* inverse to O(eps^2) *)
  Gam = Table[(1/2) Sum[gi[[a, d]] (D[g[[d, b]], pwX[[c]]] + D[g[[d, c]], pwX[[b]]] - D[g[[b, c]], pwX[[d]]]), {d, 4}], {a, 4}, {b, 4}, {c, 4}];
  Ric = Table[Sum[D[Gam[[m, a, b]], pwX[[m]]] - D[Gam[[m, a, m]], pwX[[b]]], {m, 4}] +
      Sum[Gam[[m, m, n]] Gam[[n, a, b]] - Gam[[m, b, n]] Gam[[n, a, m]], {m, 4}, {n, 4}], {a, 4}, {b, 4}];
  Rs = Sum[gi[[a, b]] Ric[[a, b]], {a, 4}, {b, 4}];
  uu = Join[{ut}, usp];
  nrm = uu . g . uu + 1;
  ns = Normal[Series[nrm /. ut -> 1 + eps s1 + eps^2 s2, {eps, 0, 2}]];
  S1 = s1 /. First[Solve[Coefficient[ns, eps, 1] == 0, s1]];
  S2 = s2 /. First[Solve[(Coefficient[ns, eps, 2] /. s1 -> S1) == 0, s2]];
  uu = uu /. ut -> 1 + eps S1 + eps^2 S2;
  Du = Table[D[uu[[b]], pwX[[a]]] + Sum[Gam[[b, a, c]] uu[[c]], {c, 4}], {a, 4}, {b, 4}];     (* nabla_a u^b *)
  Mt = Table[c1 gi[[a, b]] g[[m, n]] + c2 KroneckerDelta[a, m] KroneckerDelta[b, n] + c3 KroneckerDelta[a, n] KroneckerDelta[b, m] -
      c4 uu[[a]] uu[[b]] g[[m, n]], {a, 4}, {b, 4}, {m, 4}, {n, 4}];
  Lag = Sum[Mt[[a, b, m, n]] Du[[a, m]] Du[[b, n]], {a, 4}, {b, 4}, {m, 4}, {n, 4}];
  sq = Normal[Series[Sqrt[-Det[g]], {eps, 0, 2}]];
  Expand[SeriesCoefficient[sq (Rs - Lag), {eps, 0, 2}]]];
(* Euler-Lagrange equations of a Lagrangian with up to second derivatives of the fields f[tt, zz] *)
pwEulerLagrange[L_, flds_] := Table[Module[{f = fl[tt, zz]},
    Expand[D[L, f] - D[D[L, D[f, tt]], tt] - D[D[L, D[f, zz]], zz] + D[D[L, D[f, tt, tt]], tt, tt] +
        D[D[L, D[f, tt, zz]], tt, zz] + D[D[L, D[f, zz, zz]], zz, zz]]], {fl, flds}];
(* dispersion relation: plane waves for the live fields, gauge fields set to zero; the Fourier matrix of ALL field
   equations; the relation is the gcd of the maximal minors *)
pwDispersion[L_, flds_, gauge0_] := Module[{eqs, live, amps, ph, rep, rows, n, mins},
  eqs = pwEulerLagrange[L, flds];
  live = Complement[flds, gauge0];
  amps = Table[Symbol["pwA" <> ToString[i]], {i, Length[live]}];
  ph = Exp[I (k zz - w tt)];
  rep = Join[MapThread[(#1 -> Function[{tt, zz}, Evaluate[#2 Exp[I (k zz - w tt)]]]) &, {live, amps}],
    (# -> Function[{tt, zz}, 0]) & /@ gauge0];
  rows = Table[Module[{ee = Expand[Simplify[(e /. rep)/ph]]}, Table[Coefficient[ee, a], {a, amps}]], {e, eqs}];
  n = Length[live];
  mins = DeleteCases[Factor[Det[rows[[#]]]] & /@ Subsets[Range[Length[rows]], {n}], 0];
  Factor[PolynomialGCD @@ mins]];
pwObeys[poly_, vsq_] := TrueQ[Simplify[Numerator[Together[poly /. w -> k Sqrt[vsq]]]] === 0];
pwH2 = ConstantArray[0, {4, 4}]; pwH2[[2, 3]] = pwH2[[3, 2]] = hxy[tt, zz];
pwD2 = pwDispersion[pwLagr2[pwH2, {0, 0, 0}], {hxy}, {}];
pwH1 = ConstantArray[0, {4, 4}]; pwH1[[1, 2]] = pwH1[[2, 1]] = hA[tt, zz]; pwH1[[2, 4]] = pwH1[[4, 2]] = hB[tt, zz];
pwD1 = pwDispersion[pwLagr2[pwH1, {eps vx[tt, zz], 0, 0}], {hA, hB, vx}, {hB}];
pwH0 = DiagonalMatrix[{h00[tt, zz], hs[tt, zz], hs[tt, zz], hzz[tt, zz]}]; pwH0[[1, 4]] = pwH0[[4, 1]] = h0z[tt, zz];
pwD0 = pwDispersion[pwLagr2[pwH0, {0, 0, eps vz[tt, zz]}], {h00, h0z, hzz, hs, vz}, {h0z, hzz}];
res6 = {pwObeys[pwD2, v2sq], pwObeys[pwD1, v1sq], pwObeys[pwD0, v0sq]};
report["S06 eq:speeds derived", "259-266", "v2^2, v1^2, v0^2 from the second-order action (plane waves; spin-2, spin-1, spin-0 sectors)",
  And @@ res6, {pwD2, pwD1 /. {c3 -> 0, c4 -> 0}, pwD0 /. {c3 -> 0, c4 -> 0}}];


