(*34. Inline (L702-718): theta_pm = B pm A, untrapped spheres, the dominant energy condition, the aether deficit*)


(* LaTeX (L702-712): "The expansions of Eq.~\eqref{eq:expansions} are $\theta_\pm=B\pm A$, so a sphere is untrapped
   ($\theta_\pm>0$) when $B>|A|$. The dominant energy condition requires the energy-flux vector $-T^a{}_bu^b=\rho\,u^a+j\,e^a$
   to be causal and future-directed, i.e.\ $\rho\ge|j|$. The bracket in Eq.~\eqref{eq:dmdTheta} is then non-negative on
   untrapped spheres: outside the apparent horizon, $m$ can decrease outward only where the dominant energy condition is
   violated.  The outward decrease of $m$ in Fig.~\ref{fig:mass} therefore requires a violation of the dominant energy
   condition outside the horizon"; (L712-715) "Equation~\eqref{eq:dmdTheta}
   is linear in $T_{ab}$ and the scalar obeys the condition, so the violation comes from the \ae ther, whose contribution
   to the exterior energy is at most $-2.64$".
   Check (derivation): (i) theta_pm = B pm A (S23); theta_+ > 0 and theta_- > 0 <=> B > |A|; (ii) for the general
   T_ab = rho u_a u_b + j (u_a e_b + e_a u_b) + p e_a e_b + tangential (rho = T(u,u), j = -T(u,e)), -T^a_b u^b = rho u^a + j e^a,
   its norm is j^2 - rho^2 and its u-component -u.(..) = rho, so causal and future-directed <=> rho >= |j|;
   (iii) rho >= |j| and B > |A| => rho + (A/B) j >= 0 (Reduce), and dm/dr = B d_Theta m >= 0; (iv) the scalar has
   rho_psi = (P^2+psi'^2)/2 >= |j_psi| = |P psi'|; with E_total = E_psi + E_ae and E_psi >= 0: E_ae <= E_total = -2.64. *)
Block[{Tll, flux, nrm, futr, red, sc},
  Tll = rho0 Outer[Times, uLo, uLo] + j0 (Outer[Times, uLo, eLo] + Outer[Times, eLo, uLo]) + p0 Outer[Times, eLo, eLo];
  flux = Simplify[-(ginv . Tll) . uUp];                       (* -T^a_b u^b *)
  nrm = Simplify[flux . gmet . flux]; futr = Simplify[-uLo . flux];
  red = Reduce[ForAll[{aA, bB, rr, jj}, bB > Abs[aA] && rr >= Abs[jj], rr + (aA/bB) jj >= 0], Reals];
  sc = Reduce[ForAll[{pP, sS}, pP^2/2 + sS^2/2 >= Abs[pP sS]], Reals];
  res34 = {Simplify[thP - (BB + AA)], Simplify[thM - (BB - AA)], Simplify[flux - (rho0 uUp + j0 eUp)], Simplify[nrm - (j0^2 - rho0^2)], Simplify[futr - rho0], red, sc,
     Reduce[ForAll[{aA, bB}, Equivalent[bB + aA > 0 && bB - aA > 0, bB > Abs[aA]]], Reals], dat["Mdiff"] - 0 >= dat["aeAtMost"]};
];
report["S34 theta = B pm A, DEC, deficit", datL["decClaim"] <> ",702-718", "theta_pm = B pm A; untrapped <=> B > |A|; -T u = rho u + j e, causal+future <=> rho >= |j|; => bracket >= 0; scalar obeys DEC; aether <= total = -2.64",
  isZeroAll[res34[[1 ;; 5]]] && res34[[6]] === True && res34[[7]] === True && res34[[8]] && res34[[9]], res34[[1 ;; 5]]];


