(* ::Section:: *)
(*18. Displayed (L403-410): sources proportional to N; |beta(r)| <= N(r) Int_0^r |Q + trK/3| dr'*)


(* LaTeX (L403-409): "Every source term in the evolution equations is proportional to $N$. The advection terms are
   proportional to $\beta$ instead, but Eq.~\eqref{eq:radial} and $\beta(0)=0$ together with the monotonicity of $N$
   give  |\beta(r)|\le N(r)\int_0^r\Bigl|Q+\frac{\trK}{3}\Bigr|\,dr' , so $\beta$ also vanishes wherever the lapse has
   collapsed."
   Check (derivation): (i) the transcribed RHS with N = 0 reduces to the pure advection terms beta d_r f;
   (ii) beta(r) = Int_0^r N(r') f(r') dr' (f = Q + trK/3, from beta' = N(Q + trK/3), the second line of eq:radial) and N(r') = N(r) exp(-Int_r'^r a_r) <= N(r) for r' <= r
   when a_r >= 0 on [0, r], hence |beta| <= Int N |f| <= N(r) Int |f|.  Verified on an explicit example:
   a_r = 1/(1+r^2) >= 0 (N = exp(-(pi/2 - arctan r))), f = cos(3r) - 1/3 (changes sign), at r = 0.5 ... 8. *)
Block[{rhs0, adv, nEx, fEx, beta, bound, rs},
  rhs0 = codeRHS[0, betaf[t, r], Thf[t, r], psi[t, r], Pf[t, r], trk[t, r], Qf[t, r], arf[t, r]];
  adv = betaf[t, r] {D[Thf[t, r], r], D[psi[t, r], r], D[Pf[t, r], r], D[trk[t, r], r], D[arf[t, r], r]};
  nEx[s_] := Exp[-(Pi/2 - ArcTan[s])]; fEx[s_] := Cos[3 s] - 1/3;
  rs = {1/2, 1, 2, 3, 5, 8};
  beta = Table[NIntegrate[nEx[s] fEx[s], {s, 0, x}], {x, rs}];
  bound = Table[nEx[x] NIntegrate[Abs[fEx[s]], {s, 0, x}], {x, rs}];
  res18 = {Simplify[rhs0 - adv], Simplify[D[nEx[s], s] - nEx[s]/(1 + s^2)], Abs[beta] - bound};
  ok18 = isZeroAll[res18[[1 ;; 2]]] && Max[res18[[3]]] < 0;
];
report["S18 sources ~ N, |beta| bound", "403-410", "RHS at N = 0 is pure advection; |beta| <= N(r) Int|Q+K/3| from beta(0)=0, beta'=N(Q+K/3), N monotone (example: max(|beta|-bound) = " <> ToString[NumberForm[Max[res18[[3]]], 3]] <> ")", ok18, res18[[3]]];


(* ::Section:: *)
(*19. ALE map (L446-456) and the moving-mesh caption (L461-472)*)


(* LaTeX (L451-453): "map $r=R(x,t)=x+g(x)s(t)$, with $g$ a $C^2$ quintic taper supported for $x>0.4\,r_{\max}$ (the
   outer $60\%$ of the grid) and $s(t)$ chosen to hold $\Theta(r_{\max})$ fixed"; caption (L461) "($r_{\max}=300$,
   $N_r=25600$, $A_0=0.35$)", (L470-471) "$\ThAH$ reaches its maximum at $t\simeq28$".
   Check: collapse.cpp quintic_taper (collapse.cpp:L325-332) g(u)=10u^3-15u^4+6u^5, u=(x-0.4 rmax)/(0.6 rmax): g(0)=0, g(1)=1,
   g'=g''=0 at both ends (C^2), g''' jumps (so exactly C^2); the code's g', g'' expressions; 1-0.4 = 60%.  The caption
