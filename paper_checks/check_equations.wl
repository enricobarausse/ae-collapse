(*63. eq:mc (L1067-1074)*)


(* LaTeX (L1068-1070): m_c\equiv m-\frac{c_{14}}{2}\,\Theta^2a_r ,\qquad E(\Theta,u)\equiv\MADM-m_c(\Theta,u); "Behind the pulse
   $m_c$ settles below $\MADM$ on every sphere" (L1074-1075, simulation).
   Check: on a slice where a_r = trK = Q = psi = P = 0 outside a radius (the t=0 data), theta_C = 0 forces
   Theta'^2 = 1 - 2M/Theta, i.e. m constant = M_ADM, so m_c = M_ADM and E = 0 there initially (definitions consistent). *)
Block[{thv},
  thv = Sqrt[1 - 2 MM/Th];
