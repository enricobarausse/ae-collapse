(*77. App. B.1 (L1614-1668, L1875-1884): the single-field example; eq:simple_scalar, eq:simple_L, eq:Tp, eq:Lprime, eq:Lprime_p1*)


(* LaTeX: (L1619) \left(\nabla^2-\frac{\eta}{v^2}\partial_t^2\right)\tilde\phi=0; (L1626-1629) \mathcal{L}=-k^2(1-y),\quad
   y\equiv\frac{\eta\omega^2}{v^2k^2}\;\longleftrightarrow\;\frac{\eta}{v^2}\partial_t^2\nabla^{-2}; (L1640) T_p=\sum_{j=0}^{p}y^j;
   (L1645-1646) \mathcal{L}'=\mathcal{L}T_p=-k^2(1-y)\sum_{j=0}^{p}y^j=-k^2(1-y^{p+1}); (L1649-1651) "first appears at $(p+1)$PN,
   through a term proportional to $\eta^{p+1}\partial_t^{2p+2}(\nabla^{-2})^p$"; (L1654) \mathcal{L}'=-k^2+\frac{\eta^2\omega^4}{v^4k^2};
   (L1657-1660) "The physical root $y=1$ is still a root of $\mathcal{L}'$ ... also introduces the roots $y^{p+1}=1$ with $y\ne1$";
   operator form (L1876-1884).
   Check (derivation): on e^{-i w t} f with nabla^2 f = -k^2 f: nabla^2 -> -k^2, d_t -> -i w; the symbols above; the telescoping
   sum for general p; k^2 y^{p+1} = eta^{p+1} w^{2p+2} v^{-2p-2} k^{-2p} (one inverse Laplacian fewer than powers of y, because of
   the overall nabla^2); for p = 1..4 the roots of 1 - y^{p+1} are y = 1 and p roots y != 1. *)
Block[{yy, Lop, Tp, opsym, roots},
  yy = eta w^2/(v^2 k^2);
  Lop = -k^2 + eta w^2/v^2;                              (* (nabla^2 - eta/v^2 d_t^2) on the mode *)
  opsym = (eta/v^2) (-w^2) (-1/k^2);                    (* (eta/v^2) d_t^2 nabla^-2 *)
  Tp = Sum[yv^j, {j, 0, p}];
  roots = Table[{p0 -> Length[Select[yv /. Solve[1 - yv^(p0 + 1) == 0, yv], # =!= 1 &]]}, {p0, 1, 4}];
  res77 = {Simplify[Lop - (-k^2 (1 - yy))], Simplify[opsym - yy], Simplify[(-k^2 (1 - yv) Tp) - (-k^2 (1 - yv^(p + 1)))],
     Simplify[(-k^2 (1 - yv^2)) /. yv -> yy] - (-k^2 + eta^2 w^4/(v^4 k^2)) // Simplify,
     PowerExpand[Simplify[k^2 yy^(p + 1) - eta^(p + 1) w^(2 p + 2) v^(-2 p - 2) k^(-2 p)]]};
  ok77 = isZeroAll[res77] && (roots[[All, 1, 2]] == {1, 2, 3, 4}) && And @@ Table[MemberQ[yv /. Solve[1 - yv^(p0 + 1) == 0, yv], 1], {p0, 1, 4}];
];
report["S77 App. B.1 toy", "1614-1668,1875-1884", "eq:simple_scalar, eq:simple_L, eq:Tp, eq:Lprime, eq:Lprime_p1: L = -k^2(1-y), y <-> (eta/v^2) d_t^2 nabla^-2; L T_p = -k^2(1-y^{p+1}); p=1 form; term eta^{p+1} d_t^{2p+2} (nabla^-2)^p; y = 1 kept, p spurious roots", ok77, res77];


(* ::Section:: *)
(*78. App. B.2 (L1682): B^rr_LTF = (2/3)(gamma_2'' - gamma_2'/r)*)


(* LaTeX (L1677-1682): "\tilde B^{jk}=\delta^{jk}\tilde\gamma_1+\partial_j\partial_k\tilde\gamma_2, so that
   $\tilde B^{rr}_{\rm LTF}=\tfrac23(\tilde\gamma_2''-\tilde\gamma_2'/r)$".
   Check (derivation): in Cartesian coordinates with gamma_2(|x|), the rr component (n_j n_k) of d_j d_k gamma_2 is gamma_2'' and
   its trace is gamma_2'' + 2 gamma_2'/r; the trace-free part A^<jk> = A^jk - delta^jk A^ll/3 has rr component
   (2/3)(gamma_2'' - gamma_2'/r) (the delta gamma_1 term drops), as printed. *)
Block[{x3, rho3, g2, H, nvec, rrc, tr, tf},
  x3 = {x1, x2, x3c}; rho3 = Sqrt[x3 . x3];
  H = Table[D[gam2[rho3], x3[[i]], x3[[j]]], {i, 3}, {j, 3}];
  nvec = x3/rho3;
  rrc = Simplify[nvec . H . nvec]; tr = Simplify[Tr[H]];
  tf = Simplify[(rrc - tr/3) /. {x1 -> rr0, x2 -> 0, x3c -> 0}, rr0 > 0];
  res78 = {Simplify[tf - (2/3) (gam2''[rr0] - gam2'[rr0]/rr0)], Simplify[tf - (gam2''[rr0] - gam2'[rr0]/rr0)]};
];
report["S78 B^rr_LTF", datL["ltf"], "(d_j d_k gamma2) trace-free rr part = (2/3)(gamma2'' - gamma2'/r), as printed",
  res78[[1]] === 0 && res78[[2]] =!= 0, res78];


(* ::Section:: *)
(*79. App. B.2 (L1670-1785): spherical reduction, D0, det D0, s_{-1}, the 1PN v_L term; eq:x_def, eq:det_M0, eq:vL_def, eq:sminus1, eq:pn_1_term*)


(* LaTeX: (L1684-1685) \left(\nabla^2-\frac{2}{r^2}\right)\partial_r\tilde\kappa=\partial_r\nabla^2\tilde\kappa; (L1712-1713) "(for example,
   $f=\sin(kr)/r$)"; the reduced Eqs. (4.5a), (4.6) (L1692-1703) and the gauge conditions (L1707); (L1716-1721)
   x\equiv\frac{\eta\omega^2}{k^2}, "so that $\Box\to-k^2(1-x)$"; (L1724-1728) "$\tilde K=(\omega/k)\hat{\tilde K}$ ... $\tilde B=(\omega/k)^2\hat{\tilde B}$,
   the gauge relation gives $\hat{\tilde K}=\tilde N$"; D0 (L1740-1746); (L1751-1752) \det \mathcal{D}_0=\tfrac12(2-c_{14})c_2(1-x)^2\left(1-\frac{x}{v_L^2}\right);
   eq:vL_def (L1757); (L1768-1770) s_{-1}(x)=-\left(1-\tfrac12c_{14}\right)\left[1-(1+g_1)x+O(x^2)\right], g_1\equiv\frac{c_{14}}{2v_L^2};
   (L1782-1783) \left(1-\tfrac12c_{14}\right)g_1x=\frac{c_{14}(2-c_{14})}{4v_L^2}x.
   Check (derivation): (i) the vector-Laplacian identity with nabla^2 = r^-2 d_r(r^2 d_r); (ii) sin(kr)/r is an eigenfunction;
   (iii) on the mode (nabla^2 -> -k^2, d_t -> -i w, eta = x k^2/w^2) with kappa = -i w K_hat/k^2 (the convention for which
   K = (w/k) K_hat), kappa_ae likewise and B = (w/k)^2 B_hat: the gauge condition gives K_hat = N, the printed Eq. (4.5a) is
   k^2 times row 1 of D0 and the printed Eq. (4.6) is (i w) times minus row 3 (row 2, from (4.5c)_tr, is not printed: not
   checked); (iv) Box -> -k^2(1-x); (v) det D0 as printed (with eq:vL_def); (vi) s_{-1} = det D0/minor to O(x) as printed;
   (vii) the 1PN term. *)
Block[{lapl, kap, kae, bt0, gauge, sol, eq45a, eq46, vec, f3},
  lapl[f_] := D[r^2 D[f, r], r]/r^2;
  kap = -I w Kh/k^2; kae = -I w Ka/k^2; bt0 = (w/k)^2 Bh;
  gauge = Solve[(-I w Nn) + (-k^2) kap == 0, Kh];
  eq45a = ((1 - c14/2) (-k^2) Nn - eta (-w^2) Nn - (c14/2) eta (-k^2) bt0 + 2 eta c14 (-k^2) (-I w) (kae - kap)) /. gauge[[1]] /. eta -> xx k^2/w^2;
  eq46 = (-1/4 c14 ((-I w) Nn + eta (-I w) bt0 - 4 eta (-w^2) (kae - kap)) - 1/4 c2 (3 (-I w) Nn + 4 (-k^2) kae - eta (-I w) bt0)) /. gauge[[1]] /. eta -> xx k^2/w^2;
  vec = {Nn, Bh, Ka};
  f3 = Simplify[eq46/(D0m[[3]] . vec)];
  res79 = {Simplify[(lapl[D[kk0[r], r]] - 2 D[kk0[r], r]/r^2) - D[lapl[kk0[r]], r]], Simplify[lapl[Sin[k r]/r] + k^2 Sin[k r]/r],
     Kh /. gauge[[1]], Simplify[eq45a/k^2 - D0m[[1]] . vec], Simplify[f3 + I w], Simplify[(-k^2 + eta w^2 /. eta -> xx k^2/w^2) + k^2 (1 - xx)],
     Simplify[Det[D0m] - 1/2 (2 - c14) c2 (1 - xx)^2 (1 - xx/vL2)],
     Simplify[Normal[Series[sm1, {xx, 0, 1}]] - (-(1 - c14/2) (1 - (1 + g1) xx))], Simplify[(1 - c14/2) g1 - c14 (2 - c14)/(4 vL2)]};
];
