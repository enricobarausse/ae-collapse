(* ::Section:: *)
(*13b. eq:evolution and eq:radial (L344-361): the printed GEJ system*)


(* LaTeX (L345-352): (\partial_t-\beta\partial_r)\psi=NP,  (\partial_t-\beta\partial_r)\Theta=N\Theta(Q/2-\trK/3),
     (\partial_t-\beta\partial_r)P=N[\trK P+\psi''+(a_r+2\Theta'/\Theta)\psi'],
     (\partial_t-\beta\partial_r)\trK=N[\trK^2/3+((c_{14}-2)(a_r'+a_r^2+2a_r\Theta'/\Theta)+2P^2+3(1-c_{13})Q^2)/(2+c_{13}+3c_2)],
     (\partial_t-\beta\partial_r)a_r=N[(2\trK/3-Q)a_r+(c_{13}P\psi'-c_{123}\trK')/(c_{14}(1-c_{13}))];
   (L357-359, gathered) (1-c_{13})(Q'+3\Theta'Q/\Theta)=(2+c_{13}+3c_2)\trK'/3-P\psi',  \beta'=N(Q+\trK/3).
   Check (derivation): the printed right-hand sides, typed in independently, plus the advection beta f', equal the transcribed
   code system codeRHS component by component; the printed momentum constraint equals -momConCode (which S59 derives as
   G_ue = T_ue from the aether stress tensor); beta' is S13; the psi and Theta equations are the definitions of P and of
   u(Theta) (S14).  Negative controls: 3Q^2 instead of 3(1-c13)Q^2, +P psi' instead of -P psi', a_r - 2 Theta'/Theta in the P
   equation must all differ. *)
Block[{f = fields, lp, sh0, th, ps, m, k, q, a, pr, prBad, momC, momBad},
  {lp, sh0, th, ps, m, k, q, a} = {Nf[t, r], betaf[t, r], Thf[t, r], psi[t, r], Pf[t, r], trk[t, r], Qf[t, r], arf[t, r]};
  pr[q3_, sP_] := {sh0 D[th, r] + lp th (q/2 - k/3), sh0 D[ps, r] + lp m,
     sh0 D[m, r] + lp (k m + D[ps, {r, 2}] + (a + sP 2 D[th, r]/th) D[ps, r]),
     sh0 D[k, r] + lp (k^2/3 + ((c14 - 2) (D[a, r] + a^2 + 2 a D[th, r]/th) + 2 m^2 + q3 q^2)/(2 + c13 + 3 c2)),
     sh0 D[a, r] + lp ((2 k/3 - q) a + (c13 m D[ps, r] - c123 D[k, r])/(c14 (1 - c13)))};
  momC[sg_] := (1 - c13) (D[q, r] + 3 D[th, r] q/th) - ((2 + c13 + 3 c2)/3 D[k, r] + sg m D[ps, r]);
  res13b = Simplify[{pr[3 (1 - c13), 1] - (codeRHS @@ f), momC[-1] + momConCode[th, ps, m, k, q]}];
  bad13b = {Simplify[pr[3, 1][[4]] - (codeRHS @@ f)[[4]]], Simplify[momC[1] + momConCode[th, ps, m, k, q]], Simplify[pr[3 (1 - c13), -1][[3]] - (codeRHS @@ f)[[3]]]};
];
report["S13b eq:evolution, eq:radial", datL["evolutionEqs"], "printed psi, Theta, P, trK, a_r equations == code system; printed Q equation == momentum constraint (S59: G_ue = T_ue); 3 negative controls differ",
  isZeroAll[res13b] && And @@ (! isZero[#] & /@ bad13b), {res13b, bad13b}];



(* ::Section:: *)
(*13c. Bonetti-Barausse 3+1 equations (L339-342): alpha, beta, lambda = c14, c13, c2, f(a) = alpha a^2*)


(* LaTeX (L339-342): "The 3+1 field equations in unitary gauge, for general matter and without symmetry, are given in
   Ref.~\cite{Bonetti:2015oda} (their $\alpha$, $\beta$, $\lambda$ are our $c_{14}$, $c_{13}$, $c_2$, with $f(a)=\alpha a^2$)".
   Ref. arXiv:1502.05554 (Sec. "Modified field equations"): action (1-beta)[K_ij K^ij - (1+lambda)/(1-beta) K^2 + 3R/(1-beta)
   + f(a)/(1-beta)]; Hamiltonian constraint 3R/(1-beta) - K.K + (1+lambda)/(1-beta) K^2 + f/(1-beta) - 2 chi a^2/(1-beta)
   - 2 D_i(chi a^i)/(1-beta) = 16 pi G E/(1-beta), chi = f'(a)/(2a); momentum constraint D_j(K^ij - (1+lambda)/(1-beta) gamma^ij K)
   = -8 pi G J^i/(1-beta); their K_ij = +(1/2N)(d_t gamma_ij - ...) = minus ours; 16 pi G E -> 2 rho = P^2 + psi'^2 and
   8 pi G J^r -> j = -P psi' in our normalisation G_ab = T_ab.
   Check (derivation): (i) the mapped action equals R - (c13 K.K + c2 K^2 - c14 a^2) up to R = 3R + K.K - K^2; (ii) in spherical
   symmetry, -(Theta^2/4) x their Hamiltonian constraint (times 1-beta) is the code's theta_C = eq:hamiltonian; (iii) (1-beta) x
   their momentum constraint is the code's momentum constraint momConCode = -(Q equation of eq:radial); flipping the sign of the
   matter current makes (iii) fail. *)
Block[{al = c14, be = c13, la = c2, R3, kr, kt, KKt, Kt, divA, H, M, Mbad, g3, gi3, Gm3, Rc3, X3},
  X3 = {t, r, thA, phA};
  g3 = DiagonalMatrix[{-1, 1, Thf[t, r]^2, Thf[t, r]^2 Sin[thA]^2}] /. Thf[t, r] -> thSlice[r];
  gi3 = Inverse[g3];
  Gm3 = Table[(1/2) Sum[gi3[[a, d]] (D[g3[[d, b]], X3[[c]]] + D[g3[[d, c]], X3[[b]]] - D[g3[[b, c]], X3[[d]]]), {d, 4}], {a, 4}, {b, 4}, {c, 4}];
  Rc3 = Table[Sum[D[Gm3[[m, a, b]], X3[[m]]] - D[Gm3[[m, a, m]], X3[[b]]], {m, 4}] + Sum[Gm3[[m, m, l]] Gm3[[l, a, b]] - Gm3[[m, b, l]] Gm3[[l, a, m]], {m, 4}, {l, 4}], {a, 4}, {b, 4}];
  R3 = Simplify[Sum[gi3[[a, b]] Rc3[[a, b]], {a, 4}, {b, 4}] /. thSlice -> Function[rr, Thf[t, rr]]];
  kr = -(trk[t, r]/3 + Qf[t, r]); kt = -(trk[t, r]/3 - Qf[t, r]/2);
  KKt = kr^2 + 2 kt^2; Kt = kr + 2 kt;
  divA = D[arf[t, r], r] + 2 D[Thf[t, r], r]/Thf[t, r] arf[t, r];
  H = R3 - (1 - be) KKt + (1 + la) Kt^2 + al arf[t, r]^2 - 2 al arf[t, r]^2 - 2 al divA - (Pf[t, r]^2 + D[psi[t, r], r]^2);
  M = (1 - be) (D[kr, r] + 2 D[Thf[t, r], r]/Thf[t, r] (kr - kt) - (1 + la)/(1 - be) D[Kt, r]) - Pf[t, r] D[psi[t, r], r];
  Mbad = M + 2 Pf[t, r] D[psi[t, r], r];
  res13c = Simplify[{(1 - be) (KK0 - (1 + la)/(1 - be) K0^2) + al a20 - (KK0 - K0^2 - (c13 KK0 + c2 K0^2 - c14 a20)),
     -(Thf[t, r]^2/4) H - thetaCcode[Thf[t, r], psi[t, r], Pf[t, r], trk[t, r], Qf[t, r], arf[t, r]],
     M - momConCode[Thf[t, r], psi[t, r], Pf[t, r], trk[t, r], Qf[t, r]]}];
  bad13c = Simplify[Mbad - momConCode[Thf[t, r], psi[t, r], Pf[t, r], trk[t, r], Qf[t, r]]];
];
report["S13c Bonetti-Barausse map", datL["bonettiMap"], "mapped action = ours; -(Theta^2/4) x their Hamiltonian constraint = eq:hamiltonian (theta_C); (1-beta) x their momentum constraint = code momentum constraint = -(Q eq. of eq:radial); flipped matter sign fails",
  isZeroAll[res13c] && ! isZero[bad13c], {res13c, bad13c}];

