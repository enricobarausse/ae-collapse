   StringQ[Environment["PAPER_TEX"]], Environment["PAPER_TEX"],
   True, "main.tex"];
normTex[s_String] := StringDelete[s, {"\\", " ", "\t", "\n", "{", "}", "$", "~"}];
(* returns {n, stale keys} or $Failed if the file is absent *)
checkDataSnippets[] := Module[{lines, bad = {}, n = 0, rng, txt},
  If[! FileExistsQ[paperFile], Return[$Failed]];
  lines = Import[paperFile, "Lines"];
  KeyValueMap[Function[{k, e}, n++;
     rng = ToExpression /@ StringSplit[e["L"], "-"]; If[Length[rng] == 1, rng = {rng[[1]], rng[[1]]}];
     txt = normTex[StringRiffle[lines[[rng[[1]] ;; rng[[2]]]], "\n"]];
     If[! StringContainsQ[txt, normTex[e["tex"]]], AppendTo[bad, k <> " (L" <> e["L"] <> ")"]]], DATA];
  {n, bad}];
