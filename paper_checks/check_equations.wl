(* ::Section:: *)
(*65. eq:Einf (L1098-1111), caption L1135, conclusion L1450-1453*)


(* LaTeX (L1104-1105): E_\infty=0.532\pm0.023=(0.144\pm0.006)\,\MADM,\\ E_{\text{\ae}}=E_\infty-E_\psi=0.335=0.090\,\MADM, with
   "$E_\psi=0.197$" (L1100); "so the spin-0 wave carries off $9\%$ of the ADM mass" (L1109); caption L1135 "$E_\infty=0.53\pm0.02$";
   conclusion (L1452-1453) "$14\%$ of the ADM mass: $9\%$ in the spin-0 wave and $5\%$ in the escaping scalar field".
   Check (arithmetic on DATA): 0.532 - 0.197 = 0.335 exactly; the ratios 0.090 / 0.144 = 0.335/0.532 = 0.63 and
   0.006/0.144 = 0.023/0.532 (to rounding), i.e. the three fractions use one common M_ADM, which is 0.532/0.144 = 3.69
   (interval 3.68-3.72 within the rounding); 0.090 -> 9%, 0.144 -> 14%, 0.197/(0.532/0.144) = 5.3% -> 5%, 9 + 5 = 14; the
   caption's 0.53 +- 0.02 is eq:Einf rounded.  Which M_ADM is meant is the subject of S66. *)
Block[{e = dat["Einf"], ae = dat["Eae"], ep = dat["Erun"][[3]], cs = dat["conclSplit"], mImp},
  mImp = e[[1]]/e[[3]];
  res65 = {e[[1]] - ep, ae[[1]]/mImp, e[[2]]/mImp, ep/mImp, mImp};
  ok65 = close[res65[[1]], ae[[1]], 10^-9] && close[res65[[2]], ae[[2]], 0.002] && close[res65[[3]], e[[4]], 0.0006] &&
     Round[100 ae[[2]]] == dat["pctAe"] == cs[[2]] && Round[100 e[[3]]] == cs[[1]] && Round[100 res65[[4]]] == cs[[3]] &&
