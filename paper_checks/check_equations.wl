(*54c. The luminosity clock (L952-967, caption L989): Theta_*, slope 1/v, fit 1.241, 2%, scalar speed excluded*)


(* LaTeX (L952-954, DATA "lumDef"): "luminosity through a sphere of fixed areal radius, $L=-dm/dt|_\Theta$" (= the L of eq:lum, S56);
   (L955-958, DATA "lumBurst", "lumSpheres") "the burst coincides with the narrow pulse of $\wout$ ... on each of the
   spheres $\Theta=120$--$400$"; (L961-963, DATA "lagLine", "lagSpeed") "A signal moving at speed $v$ in tortoise distance gives a
   straight line of slope $1/v$. The arrival times lie on a line, and a linear fit gives $v=1.241$, $2\%$ below $v_0=1.267$";
   (L966-967, DATA "burstSpin0") "carried by the spin-0 mode, not by the scalar field, which propagates at the speed of light".
   Check (derivation): t_arr = t_0 + Theta_*/v gives lag = Delta Theta_*/v, slope 1/v; the scalar pair has eigenvalues beta +- N
   (S41), so its outgoing speed relative to the aether, (rdot + beta)/N, is 1.
   Check (record, not printed; release/analysis/fig_luminosity_clock.py on sl600_N25601, figure-run logs/lum_clock.log): Theta =
   120 ... 400, Theta_* (recomputed here from eq:retarded with M_ADM = 3.7084), t_arr = time of the deepest minimum of L; the
   least-squares line through (Delta Theta_*, lag) gives v = 1.2406 -> 1.241, 2.07% below v0 -> "2%", rms residual 0.31 on a lag of
   233 ("lie on a line"); slope 1 (the scalar) misses the outermost sphere by 56.  The narrow pulse of Theta w_out (steepest point,
   data/invariant_wout_dm.npz of the supplementary Fig. invariant of fig_invariant.py, not in the paper, sl600_N51201) is at u = 9.85, 12.88, 13.68 on Theta = 120, 240,
   300, where the burst (u = t_arr - Theta_*/v0) is at 9.74, 12.72, 13.62. *)
Block[{Th = RECORD["lumClock"]["Theta"], Ts = RECORD["lumClock"]["ThetaStar"], ta = RECORD["lumClock"]["tArr"],
    MM0 = RECORD["lumClock"]["MADM"], TsEq, dT, lag, fit, xx, sl, vfit, rms, uB, wPulse = RECORD["wPulse"]["u"], iPulse},
  iPulse = Flatten[Position[Th, #] & /@ RECORD["wPulse"]["Theta"]];      (* = {1, 4, 5} *)
  TsEq = Th + 2 MM0 Log[Th/(2 MM0) - 1];
  dT = Ts - Ts[[1]]; lag = ta - ta[[1]];
  fit = Fit[Transpose[{dT, lag}], {1, xx}, xx]; sl = Coefficient[fit, xx]; vfit = 1/sl;
  rms = Sqrt[Mean[(lag - (fit /. xx -> dT))^2]];
  uB = ta - Ts/v0c20;
  res54c = {Max[Abs[TsEq - Ts]], vfit, 100 (vfit/v0c20 - 1), rms, dT[[-1]] (1 - sl), Simplify[((-(bb - nn)) + bb)/nn - 1], Max[Abs[uB[[iPulse]] - wPulse]]};
  ok54c = res54c[[1]] < 0.006 && Round[vfit, 0.001] == dat["lagSpeed"][[1]] && Round[-res54c[[3]]] == dat["lagSpeed"][[2]] && res54c[[4]] < 0.01 lag[[-1]] &&
    res54c[[5]] > 50 && res54c[[6]] === 0 && res54c[[7]] < 0.5 && {Th[[1]], Th[[-1]]} == dat["lumSpheres"] && dat["lagCaption"][[1 ;; 2]] == dat["lagSpeed"];
];
report["S54c luminosity clock", "952-967,989", "Theta_* = eq:retarded to " <> ToString[NumberForm[res54c[[1]], 2]] <> "; lag = Delta Theta_*/v, fit v = " <> ToString[NumberForm[res54c[[2]], 5]] <>
  " -> 1.241, " <> ToString[NumberForm[res54c[[3]], 3]] <> "% (2%); rms " <> ToString[NumberForm[res54c[[4]], 2]] <> "; scalar (speed 1) misses by " <> ToString[Round[res54c[[5]]]] <>
  "; burst = narrow w_out pulse within " <> ToString[NumberForm[res54c[[7]], 2]] <> " in u", ok54c, res54c];


(* ::Section:: *)
(*54d. "on every sphere a sharp burst at u ~ 10-15" (L955-956) against the record*)


(* LaTeX (L955-957, DATA "lumBurst"): "For $v_0=1.267$, $L$ shows on every sphere a sharp burst at $u\simeq10$--$15$, followed
   by a broad oscillation (Fig.~\ref{fig:lum}(a))" (an earlier version, "at $u\simeq10$", was a CAVEAT; history in CHANGELOG.md).
   Check (record, as in S54c): u = t_arr - Theta_*/v0 of the burst (deepest minimum of L) on Theta = 120 ... 400 is 9.7 on the
   innermost sphere and grows to 14.7 on Theta = 400, so it rounds to the printed 10 and 15 at the two ends and lies within the
   range (to half a unit) on every sphere; the drift is Delta Theta_* (1/v - 1/v0) = 4.8 of the 2% lag itself. *)
Block[{Ts = RECORD["lumClock"]["ThetaStar"], ta = RECORD["lumClock"]["tArr"], uB},
  uB = ta - Ts/v0c20;
  res54d = {Round[uB, 0.1], (Ts[[-1]] - Ts[[1]]) (1/RECORD["lumClock"]["vFit"] - 1/v0c20)};
  ok54d = Round[Min[uB]] == dat["lumBurst"][[1]] && Round[Max[uB]] == dat["lumBurst"][[2]] &&
    And @@ Thread[dat["lumBurst"][[1]] - 1/2 <= uB < dat["lumBurst"][[2]] + 1/2];
];
report["S54d burst at u ~ 10-15", "955-956", "u of the burst (min of L) = " <> ToString[res54d[[1]]] <> " on Theta = 120 ... 400: 10 to 15 to the nearest unit, the drift = the 2% lag (" <>
  ToString[NumberForm[res54d[[2]], 2]] <> ")", ok54d, res54d];


(* ::Section:: *)
(*55. Misner-Sharp flux identity behind L1004 (time derivative at fixed areal radius = flux through the sphere)*)


(* LaTeX (L997-1002, DATA "fluxOpening"): the opening paragraph of "Mass conservation and radiated energy", "We first
   check that, at every time, the change of the Misner--Sharp mass on each sphere is accounted for by the flux of the stress-energy
   tensor through it. We then show that most of this flux is the \ae ther Coulomb field, which is linear in the wave amplitude, and
   remove it": the two steps are
   S55-S58 (the flux identity eq:lum and its residuals) and S59-S66 (the Coulomb term, eq:mc, eq:Mae, eq:Einf).
   (L1004, DATA "fluxHayward"): "The time derivative of the Misner--Sharp mass at fixed areal radius equals
   the flux of the stress-energy tensor through the sphere~\cite{Hayward:1994bu}."  The identity behind it
   (not printed in the paper, which cites it) is d_a m = (Theta^2/2)(G_a^b - delta_a^b G2) d_b Theta, G2 = G^t_t + G^r_r; at fixed
   Theta it gives dm/dt|_Theta = (Theta^2/2) G^R_T, the flux of T once G_ab = T_ab (S56).
   Check (derivation): pure geometry, for the code's metric with arbitrary N, beta, Theta (no field equations). *)
G2 = EinMD[[1, 1]] + EinMD[[2, 2]];
res55 = Simplify[Table[D[mMS, X[[a]]] - (Thf[t, r]^2/2) Sum[(EinMD[[a, b]] - KroneckerDelta[a, b] G2) dTh[[b]], {b, 4}], {a, 2}]];
report["S55 MS identity", datL["fluxHayward"], "d_a m = Th^2/2 (G_a^b - delta G2) d_b Th (identity)", isZeroAll[res55], res55];


(* ::Section:: *)
(*56. eq:lum and its definitions (L1004-1015)*)


(* LaTeX (L1007-1008): L\equiv-\left.\frac{dm}{dt}\right|_\Theta=F_{\text{\ae}}+F_\psi ,\\ F_X=\frac{N\Theta^2}{2}\left[A\,(\rho_X+p_X)+\frac{A^2+B^2}{B}\,j_X\right],
   "with $F>0$ outward, $A$, $B$, $\rho_X$ and $j_X$ as in Sec.~\ref{sec:mass} ... and $p_X=T_{ab}e^ae^b$" (L1012-1015).
   Checks (derivation): (a) -dm/dt|_Theta = (N Theta^2/2)[A(rho_G+p_G)+(A^2+B^2)/B j_G] identically, with G the Einstein
   tensor; also = -(Theta^2/2) G_T^R in areal coordinates; (b) A = Theta(Q/2-trK/3); (c) scalar projections of
   T_psi = d psi d psi - g (d psi)^2/2; (d) sign: an outgoing flat-space wave g(t-r)/r has F_psi > 0. *)
Vfix = {1, -D[Thf[t, r], t]/D[Thf[t, r], r], 0, 0};         (* d/dt at fixed areal radius *)
dmdtTh = Vfix . Table[D[mMS, X[[a]]], {a, 4}];
res56a = Simplify[{-dmdtTh - Nf[t, r] Thf[t, r]^2/2 (AA (rhoG + pG) + (AA^2 + BB^2)/BB jG),
    dmdtTh - (Thf[t, r]^2/2) Sum[Vfix[[a]] EinMD[[a, b]] dTh[[b]], {a, 4}, {b, 4}]}];
res56b = Simplify[AA - Thf[t, r] (QM/2 - trKM/3)];
dpsi = Table[D[psi[t, r], X[[a]]], {a, 4}];
Tps = Table[dpsi[[a]] dpsi[[b]] - gmet[[a, b]] (dpsi . ginv . dpsi)/2, {a, 4}, {b, 4}];
res56c = kinReduce[{uUp . Tps . uUp - (Pf[t, r]^2 + D[psi[t, r], r]^2)/2, -uUp . Tps . eUp + Pf[t, r] D[psi[t, r], r],
     eUp . Tps . eUp - (Pf[t, r]^2 + D[psi[t, r], r]^2)/2}];
Block[{ps = gg[t - r]/r}, jflat = Simplify[-D[ps, t] D[ps, r]]];   (* j_psi = -P psi' in flat space, N=1, beta=0 *)
ok56d = Simplify[jflat - gg'[t - r]^2/r^2 - gg[t - r] gg'[t - r]/r^3] === 0;   (* leading term gg'^2/r^2 > 0 *)
report["S56 eq:lum", "1004-1015", "flux formula (identity, kappa=1), A, scalar rho/j/p, F>0 outward", isZeroAll[{res56a, res56b, res56c}] && ok56d, {res56a, res56b, res56c}];


(* ::Section:: *)
(*56b. Inline (L1004): "Using the field equations G_ab = T_ab, one obtains the luminosity L"*)


(* LaTeX (L1004, DATA "lumRoute"): "Using the field equations $G_{ab}=T_{ab}$, one obtains the luminosity $L$, split into
   \ae ther and scalar-field contributions as".
   Check (derivation): sufficiency: S55 gives dm/dt|_Theta = (Theta^2/2) G^R_T for any metric, and S56 (res56a) shows
   -dm/dt|_Theta = (N Theta^2/2)[A(rho_G + p_G) + (A^2+B^2)/B j_G] identically, which is eq:lum once G_ab = T_ab.
   Necessity of the full tensor equation (why an earlier wording, "Using eq:evolution and eq:hamiltonian with eq:ms",
   was a CAVEAT): (a) m of eq:ms depends on Q, dm/dQ = Theta^2 A/2, so dm/dt|_Theta contains d_t Q, absent from
   eq:evolution (Q is fixed on each slice by eq:radial); (b) eq:lum contains the radial pressure, dF_X/dp_X =
   N Theta^2 A/2, while the trK line carries only rho + p_r + 2 p_perp (scalar: 2 P^2, whereas rho_psi + p_r =
   P^2 + psi'^2). *)
Block[{Thq, Thpq, Qq, Kq, Pq, phq, Aq, mq, mQ, evolved, rp, prp, ptp, Fx, okA, okB},
  Aq = Thq (3 Qq - 2 Kq)/6;
  mq = Thq/2 (1 - (Thpq + Aq) (Thpq - Aq));
  mQ = Simplify[D[mq, Qq]];
  evolved = {"psi", "Theta", "P", "trK", "a_r"};
  rp = (Pq^2 + phq^2)/2; prp = (Pq^2 + phq^2)/2; ptp = (Pq^2 - phq^2)/2;
  Fx = nnx56 Thq^2/2 (aa1x56 (rr1x56 + pr1x56) + (aa1x56^2 + bb1x56^2)/bb1x56 jj1x56);
  okA = isZero[mQ - Thq^2 Aq/2] && ! isZero[mQ] && FreeQ[evolved, "Q"];
  okB = isZero[D[Fx, pr1x56] - nnx56 Thq^2 aa1x56/2] && isZero[rp + prp + 2 ptp - 2 Pq^2] && ! isZero[2 Pq^2 - (rp + prp)];
  res56r = {mQ, D[Fx, pr1x56]};
  ok56r = okA && okB && isZeroAll[res56a] && isZeroAll[res55];
];
report["S56b eq:lum from G_ab = T_ab", datL["lumRoute"], "\"Using the field equations G_ab = T_ab, one obtains L\": S55 identity + G = T gives eq:lum exactly (S56); the full tensor equation is needed (dF/dp = N Theta^2 A/2, the rr equation; dm/dQ = Theta^2 A/2 needs d_t Q, absent from eq:evolution)",
  ok56r, res56r];


