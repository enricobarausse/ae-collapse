(*68. Sec. V.E = sec:pn_comparison (L1140-1243): the spin-0 mode in the post-Newtonian expansion; eq:pn_first_surviving, eq:G_exact, eq:inverse_propagator*)


(* LaTeX: (L1159-1162) "the PN analysis is carried out for $c_{13}=0$, for which the spin-0 speed $v_0$ of Eq.~\eqref{eq:speeds}
   reduces to the speed $v_L$ ..., $v_L^2=c_2(2-c_{14})/[c_{14}(2+3c_2)]$";
   (L1173-1174) \left(1-\frac{c_{14}}{2}\right)\Box N-\kappa_1\eta^2\partial_t^4\nabla^{-2}N+\cdots=0, "$\Box\equiv\nabla^2-\eta\partial_t^2$
   ... $\kappa_1\propto v_L^{-4}$";
   (L1191-1192) \Gamma(x)&=\frac{-(1-\frac12c_{14})(1-x)}{s_{-1}(x)}=\frac{1-x/x_*}{1-x/v_L^2}=1+\frac{c_{14}}2\frac{y}{1-y},
   "where $x_*\equiv2v_L^2/(2-c_{14})$" (L1196); (L1199-1201) \frac{y}{1-y}=\frac{\eta\partial_t^2}{v_L^2}\left(\nabla^2-\frac{\eta}{v_L^2}\partial_t^2\right)^{-1};
   "$\Gamma(x)$ is singular at the physical scalar pole $x=v_L^2$" (L1209-1210).
   Check (derivation): (i) v0^2 of eq:speeds at c3 = -c1 is v_L^2; (ii) with the matrix D0 of App. B (L1740-1746, typed in
   here) s_{-1} = det D0 / (minor of the lapse entry) [eliminating B, K_ae], and Gamma equals both printed forms exactly;
   (iii) on a mode e^{-i w t} f, nabla^2 f = -k^2 f, eta = x k^2/w^2: the inverse propagator is y/(1-y), y = x/v_L^2, and the
   2PN lapse equation is k^2 s_1(x) with s_1 of eq:s1 (S80); (iv) the numerator of Gamma at x = v_L^2 is c14/2 != 0, so the
   pole is not cancelled; kappa_1 = c14(2-c14)/(4 v_L^4). *)
vL2 = c2 (2 - c14)/(c14 (2 + 3 c2));
vT2 = c1/c14;
D0m = {{-1 + c14/2 - (2 c14 - 1) xx, c14/2 xx, 2 c14 xx},
   {-9/2 c2, -1 + (1 + 3/2 c2) xx, 6 c2},
   {-1/4 (3 c2 + c14) + c14 xx, 1/4 (c2 - c14) xx, c2 - c14 xx}};
sm1 = Simplify[Det[D0m]/Det[D0m[[2 ;; 3, 2 ;; 3]]]];
g1 = c14/(2 vL2);
kappa1 = c14 (2 - c14)/(4 vL2^2);
D1m = DiagonalMatrix[{-(1 - c14/2) (1 - xx), -(1 - xx), c1 (1 - xx/vT2)}];
T1m = Map[Normal[Series[#, {xx, 0, 1}]] &, Simplify[Inverse[D0m] . D1m], {2}];
DT1 = Expand[D0m . T1m];
s1x = Simplify[Det[DT1]/Det[DT1[[2 ;; 3, 2 ;; 3]]]];
Block[{xs = 2 vL2/(2 - c14), y = xx/vL2, Gam0, eta, lapOp},
  Gam0 = -(1 - c14/2) (1 - xx)/sm1;
  eta = xx k^2/w^2;
  lapOp = (1 - c14/2) (-k^2) (1 - xx) - kappa1 eta^2 w^4 (-1/k^2);
  res68 = Simplify[{(v0sq /. c3 -> -c1) - vL2, (v1sq /. c3 -> -c1) - vT2, Gam0 - (1 - xx/xs)/(1 - xx/vL2), Gam0 - (1 + c14/2 y/(1 - y)),
      ((eta (-w^2)/vL2)/(-k^2 + eta w^2/vL2)) - y/(1 - y), lapOp - k^2 (-(1 - c14/2) (1 - xx) + kappa1 xx^2),
      ((1 - xx/xs) /. xx -> vL2) - c14/2, kappa1 vL2^2 - c14 (2 - c14)/4}];
];
report["S68 PN: v_L, Gamma, inverse propagator", "1140-1243", "eq:pn_first_surviving, eq:G_exact, eq:inverse_propagator: v0^2(c13=0) = v_L^2; v1^2(c13=0) = c1/c14; Gamma = -(1-c14/2)(1-x)/s_{-1} = (1-x/x*)/(1-x/vL^2) = 1 + (c14/2) y/(1-y) exactly; inverse propagator = y/(1-y); 2PN lapse operator = k^2 s_1; pole at x = vL^2 not cancelled",
  isZeroAll[res68], res68];


