(* ::Section:: *)
(*54a. eq:wbar (L897-906): the Gaussian running mean and delta w_out, against release/analysis/spin0_common.py*)


(* LaTeX (L897-906, DATA "wbarEq"): "To isolate the pulse, we split $\wout$ on each sphere into a slowly varying background
   $\bar w_{\rm out}$ and a fast remainder $\delta\wout$, smoothing $\wout$ in time with a Gaussian kernel:
   \bar w_{\rm out}(\Theta,t) = \int\wout(\Theta,t') e^{-(t-t')^2/2\sigma^2} dt' / \int e^{-(t-t')^2/2\sigma^2} dt',
   and $\delta\wout=\wout-\bar w_{\rm out}$", and "With a width $\sigma=10$, the remainder isolates the pulse ... for any $\sigma\in[5,15]$" (L907-909, DATA "sigmaFilter").
   Check (derivation): the kernel is normalised, so on ANY interval [a, b] of t' (the printed integrals carry no limits; on data
   they run over the available dumps) a constant is returned exactly and delta of a constant is 0; on the whole line a + b t is
   returned unchanged, t^2 -> t^2 + sigma^2, and cos(omega t) -> Exp[-sigma^2 omega^2/2] cos(omega t), so delta w_out is a
   high-pass filter (transfer 1 - Exp[-sigma^2 omega^2/2]).
   Check (code, numerical): release/analysis/spin0_common.py gaussian_running_mean, transcribed: weights
   Exp[-(t_s - t_i)^2/2 sigma^2] dt_s with dt = np.gradient(t), restricted to |t_s - t_i| <= 3 sigma and renormalised by their
   sum (so the ends of the data are the printed ratio over the data range); fig_wout_background.py calls it per sphere with
   --sigma 10 (default; the release README recipe passes none; --sigma_scan 5,7.5,10,12.5,15) and plots only t <= t_end - 3 sigma.
   On a test series (broad hump 0.5 + narrow pulse 0.07, dumps every 0.5 up to t = 300, sigma = 10): a constant is returned to
   rounding at every t, and the code differs from the untruncated trapezoidal ratio by less than the dropped kernel weight
   1 - Erf[3/Sqrt[2]] = 0.27% times max|w|.  Record (not printed; data/wout_background.npz of the figure runs, sigma = 10 stored, recomputed
   off line): max |Theta (w_bar_code - w_bar_eq)| = 2.6e-4 - 3.6e-4 on the seven spheres, <= 0.5% of the pulse amplitude 0.071-0.073. *)
Block[{t, tp, x, a, b, c0, c1s, om, sg, ker, wbarI, res, grm, tt, y, yb, yc, ye, trap, dmax, cut, rec = {3.6*^-4, 3.3*^-4, 3.2*^-4, 2.9*^-4, 2.9*^-4, 3.4*^-4, 2.6*^-4},
    pul = {0.0727, 0.0706, 0.0706, 0.0709, 0.0716, 0.0723, 0.0734}},
  ker = Exp[-(t - tp)^2/(2 sg^2)];
  wbarI[f_, lo_, hi_] := Integrate[f ker, {tp, lo, hi}, Assumptions -> sg > 0 && Element[t, Reals] && a < b]/Integrate[ker, {tp, lo, hi}, Assumptions -> sg > 0 && Element[t, Reals] && a < b];
  res = Simplify[{wbarI[c0, a, b] - c0, wbarI[c0 + c1s tp, -Infinity, Infinity] - (c0 + c1s t), wbarI[tp^2, -Infinity, Infinity] - (t^2 + sg^2),
      Integrate[Cos[om (t + x)] Exp[-x^2/(2 sg^2)], {x, -Infinity, Infinity}, Assumptions -> sg > 0 && Element[{t, om}, Reals]]/(Sqrt[2 Pi] sg) - Exp[-sg^2 om^2/2] Cos[om t]},
    sg > 0 && Element[{t, om}, Reals]];
  grm[ts_, ys_, sig_, tr_] := Module[{dt = Join[{ts[[2]] - ts[[1]]}, (ts[[3 ;;]] - ts[[;; -3]])/2, {ts[[-1]] - ts[[-2]]}], sel, w},
    Table[sel = Flatten[Position[Abs[ts - ti], _?(# <= tr sig &)]]; w = Exp[-0.5 ((ts[[sel]] - ti)/sig)^2] dt[[sel]]; w . ys[[sel]]/Total[w], {ti, ts}]];
  tt = N[Range[0.5, 300, 0.5]];
  y = 0.5 Exp[-((tt - 120)/40)^2] + 0.07 Exp[-((tt - 150)/2)^2] Cos[tt - 150];
  yb = grm[tt, y, 10., 3.]; yc = grm[tt, ConstantArray[3.7, Length[tt]], 10., 3.];
  trap[f_] := Total[(f[[2 ;;]] + f[[;; -2]])/2 Differences[tt]];
  ye = Table[With[{k = Exp[-0.5 ((tt - ti)/10.)^2]}, trap[k y]/trap[k]], {ti, tt}];
  dmax = Max[Abs[yb - ye]]; cut = N[1 - Erf[3/Sqrt[2]]];
  res54a = {res, Max[Abs[yc - 3.7]], dmax, cut, Max[rec]/Min[pul]};
  ok54a = isZeroAll[res] && res54a[[2]] < 10^-12 && dmax < cut Max[Abs[y]] && cut < 0.003 && res54a[[5]] <= 0.01 && dat["sigmaFilter"][[1]] == 10;
];
sci54a[x_, d_] := With[{e = Floor[Log10[x]]}, ToString[NumberForm[N[x/10^e], d]] <> "e" <> ToString[e]];
report["S54a eq:wbar running mean", "897-909", "w_bar[c] = c on any interval (delta of a constant = 0), a + b t kept, t^2 -> t^2 + sigma^2, transfer Exp[-sigma^2 omega^2/2]; code (3-sigma truncation, renormalised ends, sigma = 10): constant to " <>
  sci54a[res54a[[2]], 1] <> ", test series |code - eq| = " <> sci54a[res54a[[3]], 2] <> " < 0.27% max|w|; figure record <= " <> ToString[NumberForm[100 res54a[[5]], 2]] <> "% of the pulse", ok54a, res54a];


