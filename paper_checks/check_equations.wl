   the variables (trK, a_r | Theta, psi, P) the symbol has a zero lower-left block. *)
Block[{th = Thf[t, r], ps = psi[t, r], pm = Pf[t, r], kk = trk[t, r], q = Qf[t, r], a = arf[t, r], b = betaf[t, r], nl = Nf[t, r], kPrinted, aPrinted, rhs},
  kPrinted = b D[kk, r] + nl/3 kk^2 + nl/(2 + c13 + 3 c2) (2 pm^2 + 3 (1 - c13) q^2 + (c14 - 2) (D[a, r] + a^2 + 2 D[th, r]/th a));
  aPrinted = b D[a, r] + nl (2 kk/3 - q) a + nl (c13 pm D[ps, r] - c123 D[kk, r])/(c14 (1 - c13));
  rhs = codeRHS @@ fields;
