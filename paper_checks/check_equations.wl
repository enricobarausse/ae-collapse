(*54b. The probe (L940-947, caption L976-977): exact speed v0 relative to the aether; medians, early scatter, bound 3e-4*)


(* LaTeX (L940-943, DATA "probeExact"): "As shown in Sec.~\ref{sec:principal}, the outgoing spin-0 characteristic moves at exactly
   $v_0$ relative to the \ae ther, measured in its proper time and proper radial distance, so this measurement requires no
   approximation of the background"; (L944-947, DATA "probeScatter", "probeMedText") "The scatter at early times, $t\lesssim40$, comes from the
   splitting of the initial $\trK$ pulse ... afterwards, the deviation stays below $3\times10^{-4}$. The median speed agrees with $v_0$
   to $0.01\%$ for $v_0=1$ and to $0.02\%$ for $v_0=1.267$."
   Check (derivation): the outgoing eigenvalue beta - N v0 of the principal part (S39) gives rdot = -beta + N v0, so
   v = (rdot + beta)/N = v0 identically in N and beta (gamma_rr = 1: proper radial distance dr, aether proper time N dt).
   Check (record, not printed; release/analysis/fig_probe_speed.py, figure-run logs/probe.log and data/probe_speed.npz, 134 / 127
   samples from t = 16): (median - v0)/v0 = 0.0122% (v0 = 1) and 0.0154% (v0 = 1.267), which round to the printed 0.01% and
   0.02%; max |v - v0|/v0 for t >= 40: 2.96e-4 and 1.89e-4, below 3e-4; for t < 40: 3.84e-4 and 3.22e-4, the larger early scatter. *)
Block[{Ms, ev, rd, med = {0.0122, 0.0154}, late = {2.96*^-4, 1.89*^-4}, early = {3.84*^-4, 3.22*^-4}},
  Ms = {{bb, nn aa}, {nn bb2, bb}};
  rd = -(bb - nn v);   (* outgoing characteristic of the eigenvalue beta - N v0 *)
  res54b = {Simplify[Det[Ms - (bb - nn v) IdentityMatrix[2]] /. aa -> v^2/bb2], Simplify[(rd + bb)/nn - v], Round[med, 0.01], Max[late], early - late};
  ok54b = isZeroAll[res54b[[1 ;; 2]]] && FreeQ[Simplify[(rd + bb)/nn], nn | bb] && closeAll[res54b[[3]], dat["probeMedText"], 10^-9] &&
    dat["probeMedText"] == dat["probeDev"] && res54b[[4]] < dat["probeScatter"][[2]] && And @@ Positive[res54b[[5]]];
];
report["S54b probe speed", "940-947,976-977", "(rdot + beta)/N = v0 exactly for the outgoing spin-0 characteristic (no background approximation); record: medians 0.0122% / 0.0154% -> 0.01% / 0.02%; max |v - v0|/v0 for t >= 40 = 2.96e-4 / 1.89e-4 < 3e-4, larger before (3.84e-4 / 3.22e-4)", ok54b, res54b];


