(*80. App. B.3 (L1787-1907): the first-order redefinition, D1, s_1, kappa_1*)


(* LaTeX: eq:N_transform (L1795-1804) \tilde N=\left[1+\frac{c_{14}}{2v_L^2}\eta\partial_t^2\nabla^{-2}\right]N+x\left[\frac{c_{14}}{2-c_{14}}B+\frac{2c_1}{v_L^2}K_{\text{\ae}}\right];
   first column of T_1 at x^0 (L1818-1819) \left(1,\tfrac32c_{14},\frac{c_{14}+3c_2}{4c_2}\right)^T; eq:M1 (L1824-1825)
   \mathcal{D}_1(x)=\mathrm{diag}\Bigl(-(1-\tfrac12c_{14})(1-x),\,-(1-x),\,c_1(1-x/v_T^2)\Bigr)+O(x^2), "$v_T^2=c_1/c_{14}$" (L1829);
   eq:s1 (L1839) s_1(x)=-(1-\tfrac12c_{14})(1-x)+\kappa_1x^2+O(x^3); eq:kappa1 (L1845-1848) \kappa_1=g_1\frac{c_{14}(2+3c_2)}{2c_2}=\frac{c_{14}(2-c_{14})}{4v_L^4};
   (L1864) \Gamma=1+\frac{c_{14}}2(y+y^2+\cdots); (L1870) s_1=s_{-1}\left(1+\frac{c_{14}}2y\right)+O(x^3); (L1895) \det \mathcal{D}_1=\det \mathcal{D}_0\,\det T_1.
   Check (derivation): T1 = D0^-1 D1 truncated at O(x) (the first-order transformation that makes D0 T1 diagonal to O(x)) has
   first row (1 + g1 x, x c14/(2-c14), x 2c1/vL^2) = eq:N_transform (with eta d_t^2 nabla^-2 -> x) and first column at x = 0 as
   printed; D0 T1 - D1 = O(x^2) (eq:M1); s_1 = det(D0 T1)/minor to O(x^2) is eq:s1 with kappa_1 = c14(2-c14)/(4 vL^4) = the
   g1 form; s_1 - s_{-1}(1 + c14 y/2) = O(x^3); the series of Gamma; det of a product.  Summary (L1902-1905): "in the first-order
   truncation the explicit $v_L$ dependence of the reduced lapse equation is absent through 1PN and reappears at 2PN": the x^0
   and x^1 coefficients of s_1 do not depend on c2 at fixed c14 (i.e. on v_L), the x^2 one (kappa_1) does. *)
Block[{y = xx/vL2, Gam0 = -(1 - c14/2) (1 - xx)/sm1},
  res80 = {Simplify[T1m[[1]] - {1 + g1 xx, xx c14/(2 - c14), xx 2 c1/vL2}], Simplify[(T1m[[All, 1]] /. xx -> 0) - {1, 3 c14/2, (c14 + 3 c2)/(4 c2)}],
     Simplify[Map[Normal[Series[#, {xx, 0, 1}]] &, DT1 - D1m, {2}]], Simplify[Normal[Series[s1x, {xx, 0, 2}]] - (-(1 - c14/2) (1 - xx) + kappa1 xx^2)],
     Simplify[g1 c14 (2 + 3 c2)/(2 c2) - kappa1], Simplify[Normal[Series[s1x - sm1 (1 + c14/2 y), {xx, 0, 2}]]],
     Simplify[Normal[Series[Gam0, {xx, 0, 3}]] - (1 + c14/2 (y + y^2 + y^3))], Simplify[Det[D0m . T1m] - Det[D0m] Det[T1m]],
     Simplify[vT2 - c1/c14]};
  (* summary (L1902-1905): at fixed c14, v_L^2 depends on c2, so "no explicit v_L dependence" = no c2 at fixed c14 *)
  sum80 = Module[{ser = Expand[Normal[Series[s1x, {xx, 0, 2}]]]}, {Simplify[D[Coefficient[ser, xx, 0], c2]], Simplify[D[Coefficient[ser, xx, 1], c2]],
     ! TrueQ[Simplify[D[Coefficient[ser, xx, 2], c2]] == 0]}];
];
report["S80 App. B.3 redefinition", "1787-1907", "T1 = D0^-1 D1 to O(x): row 1 = eq:N_transform, column 1 at x^0 as printed; D0 T1 = eq:M1 + O(x^2); s_1 = eq:s1, kappa_1 (both forms); s_1 = s_{-1}(1 + c14 y/2) + O(x^3); Gamma series; det identity; summary: no v_L in s_1 through 1PN, v_L at 2PN",
  isZeroAll[res80] && isZeroAll[sum80[[1 ;; 2]]] && sum80[[3]], {res80, sum80}];


