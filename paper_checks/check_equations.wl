(*1. Introduction (L140-143): omega^2 = k^2 + alpha k^4 + beta k^6, group velocity without bound*)


(* LaTeX (L140-143): "the higher spatial derivatives make the dispersion relations anisotropic,
   $\omega^2=k^2+\alpha k^4+\beta k^6$ schematically, so the group velocity grows without bound in the ultraviolet".
   Check (derivation): v_g = d omega/dk for this omega(k); its limit k -> infinity is +infinity for beta > 0 (it grows
   as 3 sqrt(beta) k^2), and also for beta = 0, alpha > 0 (as 2 sqrt(alpha) k). *)
Block[{om, vg},
  om = Sqrt[k^2 + al k^4 + be k^6];
  vg = D[om, k];
  res01 = {Limit[vg, k -> Infinity, Assumptions -> be > 0 && al \[Element] Reals],
     Limit[vg/k^2, k -> Infinity, Assumptions -> be > 0 && al \[Element] Reals],
     Limit[(vg /. be -> 0), k -> Infinity, Assumptions -> al > 0]};
];
report["S01 UV dispersion", "140-143", "omega^2 = k^2 + alpha k^4 + beta k^6: d omega/dk -> Infinity (~ 3 sqrt(beta) k^2)", res01[[1]] === Infinity && Simplify[res01[[2]] - 3 Sqrt[be], be > 0] === 0 && res01[[3]] === Infinity, res01];


