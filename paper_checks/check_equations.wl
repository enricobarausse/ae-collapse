(* ::Section:: *)
(*16. eq:constraint-prop (L384-393), with d_r ln N = alphabar a_r*)


(* LaTeX (L384): "We check this by relaxing Eq.~\eqref{eq:lapse} to $\partial_r\ln N=\bar\alpha\,a_r$"; (L384-393) "Near the
   centre, the constraint of Eq.~\eqref{eq:hamiltonian} behaves as $C=C_1\,r+O(r^3)$, and for data with $C=0$
     \left.\frac{dC_1}{dt}\right|_{C=0}=(1-\bar\alpha)\,a_r'(0)\,\trK(0)\,N(0), which vanishes only for $\bar\alpha=1$".
   Check (derivation): expand all fields about the regular centre with the correct parities
   (Theta odd, psi, P, trK, Q even, a_r odd, Q(0)=0), N = N(0) exp(alphabar Int a_r), beta = Int_0^r N(Q+trK/3),
   Q from the regular solution of the momentum-constraint ODE (5 q2 = S1, as in compute_Q).  C = theta_C/Theta is odd,
   C = C1 r + O(r^3).  Time derivatives of the Taylor coefficients come from the code's RHS.  On C1 = 0 we find
   dC1/dt = (1-alphabar) a1 k0 n0 exactly, a1 = a_r'(0), k0 = trK(0), n0 = N(0). *)
Block[{thS, psS, momS, kS, aS, Sexpr, q2, qS, lapS, shS, rhsS, Cser, C0v, C1v, dots, dC1, th3sol},
  thS = r + th3 r^3 + th5 r^5; psS = p0 + p2 r^2 + p4 r^4; momS = P0 + P2 r^2 + P4 r^4;
  kS = k0 + k2 r^2 + k4 r^4; aS = a1 r + a3 r^3 + a5 r^5;
  Sexpr = (-momS D[psS, r] + (den/3) D[kS, r])/(1 - c13);
  q2 = SeriesCoefficient[Sexpr, {r, 0, 1}]/5; qS = q2 r^2;
  lapS = n0 Exp[alb Integrate[aS /. r -> sD, {sD, 0, r}]];
  shS = Integrate[Normal[Series[lapS (qS + kS/3), {r, 0, 4}]] /. r -> sD, {sD, 0, r}];
  rhsS = codeRHS[lapS, shS, thS, psS, momS, kS, qS, aS];
  Cser = thetaCcode[thS, psS, momS, kS, qS, aS]/thS;
  C0v = Simplify[SeriesCoefficient[Cser, {r, 0, 0}]];
  C1v = Simplify[SeriesCoefficient[Cser, {r, 0, 1}]];
  dots = {SeriesCoefficient[rhsS[[1]], {r, 0, 3}], SeriesCoefficient[rhsS[[5]], {r, 0, 1}],
          SeriesCoefficient[rhsS[[3]], {r, 0, 0}], SeriesCoefficient[rhsS[[4]], {r, 0, 0}]};
  dC1 = {D[C1v, th3], D[C1v, a1], D[C1v, P0], D[C1v, k0]} . dots;
  th3sol = th3 /. First[Solve[C1v == 0, th3]];
  res16 = Simplify[(dC1 /. th3 -> th3sol) - (1 - alb) a1 k0 n0];
  ok16 = (C0v === 0) && (res16 === 0) && SubsetQ[{th3, a1, P0, k0, c1, c2, c3, c4}, Variables[C1v]];
];
report["S16 eq:constraint-prop", "384-393", "dC1/dt|_{C=0} = (1-alphabar) a_r'(0) trK(0) N(0) (Taylor expansion at r=0)", ok16, res16];


